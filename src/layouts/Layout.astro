---
import '@styles/global.css';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import WavesBg from '@components/effects/gradient-waves/WavesBg.jsx';
import ClickSparkLayer from '@components/effects/click-spark/ClickSparkLayer.jsx';
import { profile } from '@data/profile';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.summary,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          const params = new URLSearchParams(location.search).get('theme');
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme =
            params === 'light' || params === 'dark'
              ? params
              : stored === 'light' || stored === 'dark'
                ? stored
                : prefersDark
                  ? 'dark'
                  : 'light';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body class="space-root min-h-screen antialiased">
    <div class="progress" data-progress></div>
    <div class="waves-bg" aria-hidden="true">
      <WavesBg client:load />
    </div>
    <div class="ambient" aria-hidden="true">
      <div class="orb orb-a" data-orb="a"></div>
      <div class="orb orb-b" data-orb="b"></div>
    </div>
    <div class="grain" aria-hidden="true"></div>
    <div class="click-spark" aria-hidden="true">
      <ClickSparkLayer client:load />
    </div>
    <Header />
    <main class="site-main pt-16 sm:pt-24">
      <slot />
    </main>
    <Footer />
    <script>
      import { initMotion } from '@lib/motion';
      import { initTheme } from '@lib/theme';
      initTheme();
      initMotion();
    </script>
  </body>
</html>
