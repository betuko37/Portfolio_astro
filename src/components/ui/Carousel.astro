---
import type { GalleryImage, GalleryVariant } from '@data/media';
import AppIcon from '@components/ui/AppIcon.astro';

interface Props {
  images: GalleryImage[];
  variant?: GalleryVariant;
  title?: string;
}

const { images, variant = 'desktop', title = 'Capturas' } = Astro.props;
const phone = variant === 'phone';
const multi = images.length > 1;
---

{images.length > 0 && (
  <section class="px-4 pb-10 pt-4 md:px-8 md:pb-16" data-reveal>
    <div class="mx-auto max-w-6xl">
      <p class="inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-accent">
        <AppIcon name="image" size={14} />
        {title}
      </p>

      <div
        class:list={['carousel mt-8 md:overflow-visible', !phone && 'coverflow overflow-x-clip']}
        data-carousel
        data-variant={variant}
        data-count={images.length}
      >
        <div class:list={['relative', phone ? 'mx-auto max-w-sm' : 'w-full']}>
          {phone ? (
            <div class="device">
              <span class="device-notch"></span>
              <div class="device-screen relative aspect-[9/19]">
                {images.map((image, index) => (
                  <figure
                    class="carousel-slide absolute inset-0 cursor-zoom-in"
                    data-slide
                    data-slide-index={index}
                    data-active={index === 0 || undefined}
                  >
                    <img
                      src={image.src}
                      alt={image.alt}
                      class="h-full w-full object-cover"
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                  </figure>
                ))}
              </div>
            </div>
          ) : (
            <div class="coverflow-stage relative mx-auto w-full max-w-4xl overflow-visible px-[4%]" data-coverflow-stage>
              <div class="carousel-stage-sizer" aria-hidden="true">
                <img
                  data-carousel-sizer
                  src={images[0]?.src}
                  alt=""
                  class="block h-auto w-full"
                  loading="eager"
                />
              </div>
              {images.map((image, index) => (
                <figure
                  class:list={[
                    'carousel-slide carousel-slide-cover absolute top-0 cursor-zoom-in overflow-hidden rounded-[1.25rem] bg-sand ring-1 ring-black/5',
                    index === 0 && 'is-active',
                  ]}
                  data-slide
                  data-slide-index={index}
                  data-active={index === 0 || undefined}
                >
                  <img
                    src={image.src}
                    alt={image.alt}
                    class="pointer-events-none block h-auto w-full"
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                </figure>
              ))}
            </div>
          )}

          <p class="carousel-hint mt-3 text-center text-xs text-muted">
            Clic en una captura para verla en grande
          </p>

          {multi && (
            <div class="mt-4 flex items-center justify-center gap-3">
              <button
                class="btn-accent carousel-prev inline-flex h-9 w-9 items-center justify-center rounded-full"
                type="button"
                aria-label="Anterior"
                data-magnetic
              >
                <AppIcon name="arrow-right" size={14} class="rotate-180" />
              </button>
              <button
                class="btn-accent carousel-next inline-flex h-9 w-9 items-center justify-center rounded-full"
                type="button"
                aria-label="Siguiente"
                data-magnetic
              >
                <AppIcon name="arrow-right" size={14} />
              </button>
            </div>
          )}
        </div>

        {multi && (
          <div class="mt-5 flex flex-wrap items-center justify-center gap-2">
            {images.map((image, index) => (
              <button
                class:list={[
                  'carousel-dot overflow-hidden rounded-full opacity-55 transition-opacity',
                  phone ? 'h-12 w-7' : 'h-11 w-[4.25rem]',
                  index === 0 && 'is-active opacity-100',
                ]}
                type="button"
                data-dot
                data-index={index}
                aria-label={`Ir a captura ${index + 1}`}
              >
                <img src={image.src} alt="" class="h-full w-full bg-sand object-contain object-center" />
              </button>
            ))}
          </div>
        )}

        <dialog class="carousel-lightbox" data-carousel-lightbox aria-label="Capturas en pantalla completa">
          <div class="carousel-lightbox-panel">
            <div class="carousel-lightbox-toolbar">
              <p class="carousel-lightbox-meta">
                <span data-lightbox-counter>1 / {images.length}</span>
                <span class="carousel-lightbox-caption" data-lightbox-caption>{images[0]?.alt}</span>
              </p>
              <button
                class="carousel-lightbox-close inline-flex h-9 w-9 items-center justify-center rounded-full bg-sand text-ink"
                type="button"
                data-carousel-lightbox-close
                aria-label="Cerrar"
              >
                <AppIcon name="x" size={18} />
              </button>
            </div>

            <div class="carousel-lightbox-body">
              <figure class="carousel-lightbox-hero">
                <img
                  data-lightbox-hero
                  src={images[0]?.src}
                  alt={images[0]?.alt ?? ''}
                  class="block max-h-[82vh] w-auto max-w-[min(96vw,88rem)] rounded-[1rem] bg-sand object-contain shadow-2xl ring-1 ring-white/10"
                  loading="eager"
                />
              </figure>
            </div>

            {multi && (
              <div class="mt-5 flex items-center justify-center gap-3">
                <button
                  class="btn-accent carousel-lightbox-prev inline-flex h-9 w-9 items-center justify-center rounded-full"
                  type="button"
                  aria-label="Anterior"
                >
                  <AppIcon name="arrow-right" size={14} class="rotate-180" />
                </button>
                <button
                  class="btn-accent carousel-lightbox-next inline-flex h-9 w-9 items-center justify-center rounded-full"
                  type="button"
                  aria-label="Siguiente"
                >
                  <AppIcon name="arrow-right" size={14} />
                </button>
              </div>
            )}
          </div>
        </dialog>
      </div>
    </div>
  </section>
)}
