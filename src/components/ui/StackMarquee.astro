---
import BrandIcon from '@components/ui/BrandIcon.astro';
import { isBrandImage } from '@data/brands';

interface Props {
  items: readonly string[];
  single?: boolean;
  compact?: boolean;
}

const { items, single = false, compact = false } = Astro.props;

function splitRows(list: readonly string[], rows = 3) {
  const size = Math.ceil(list.length / rows);
  return Array.from({ length: rows }, (_, index) =>
    list.slice(index * size, (index + 1) * size),
  ).filter((row) => row.length > 0);
}

const loop = (row: readonly string[]) => [...row, ...row];
const marqueeRows = single ? [items] : splitRows(items);
---

<div class="space-y-3">
  {marqueeRows.map((row, index) => (
    <div class="marquee">
      <div
        class:list={[
          'marquee-track',
          index === 1 && 'reverse',
          index === 2 && 'slow',
        ]}
      >
        {loop(row).map((item) => (
          <span class:list={['text-ink', compact ? 'deck-pill' : 'inline-flex items-center gap-2 rounded-full bg-paper px-4 py-2 text-sm']}>
            <BrandIcon label={item} size={isBrandImage(item) ? (compact ? 15 : 18) : (compact ? 13 : 15)} />
            {item}
          </span>
        ))}
      </div>
    </div>
  ))}
</div>
