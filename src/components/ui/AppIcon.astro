---
import type { IconName } from '@data/icons';
import Archive from '@lucide/astro/icons/archive';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Atom from '@lucide/astro/icons/atom';
import AudioLines from '@lucide/astro/icons/audio-lines';
import BadgeCheck from '@lucide/astro/icons/badge-check';
import Bookmark from '@lucide/astro/icons/bookmark';
import Box from '@lucide/astro/icons/box';
import Boxes from '@lucide/astro/icons/boxes';
import Brain from '@lucide/astro/icons/brain';
import Briefcase from '@lucide/astro/icons/briefcase';
import Building2 from '@lucide/astro/icons/building-2';
import ChartColumn from '@lucide/astro/icons/chart-column';
import CircleAlert from '@lucide/astro/icons/circle-alert';
import Clock from '@lucide/astro/icons/clock';
import Cloud from '@lucide/astro/icons/cloud';
import Code from '@lucide/astro/icons/code';
import Cpu from '@lucide/astro/icons/cpu';
