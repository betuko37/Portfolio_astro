---
import type { GalleryImage, GalleryVariant } from '@data/media';
import AppIcon from '@components/ui/AppIcon.astro';
import LenticularGallery from '@components/ui/LenticularGallery';

interface Props {
  images: GalleryImage[];
  variant?: GalleryVariant;
  title?: string;
  shell?: 'default' | 'project';
}

const { images, variant = 'desktop', title = 'Capturas', shell = 'default' } = Astro.props;
const phone = variant === 'phone';
const items = images.map((image) => ({
  image: image.src,
  label: image.alt,
  alt: image.alt,
}));
const initialIndex = Math.min(Math.floor(images.length / 2), Math.max(0, images.length - 1));
---

{images.length > 0 && (
  <section class:list={['px-4 pb-8 pt-4 md:px-8 md:pb-16', shell === 'project' && 'project-carousel']} data-reveal>
    <div class="mx-auto max-w-6xl">
      <p class="deck-eyebrow">
        <AppIcon name="image" size={14} />
        {title}
      </p>

      <div class="lenticular-gallery mt-5 md:mt-8">
        <LenticularGallery
          client:visible
          images={items}
          initialIndex={initialIndex}
          cardWidth={phone ? 220 : 300}
          aspectRatio={phone ? '9 / 19' : '16 / 10'}
          gap={phone ? 18 : 24}
          borderRadius={phone ? 18 : 16}
          strips={phone ? 48 : 56}
          loop={images.length > 1}
          trigger="hover"
          showLabels
          showControls={images.length > 1}
          showDots={images.length > 1}
          enableDrag={images.length > 1}
          enableKeyboard
          labelColor="#ffffff"
          className="rounded-[1.25rem] border border-[color-mix(in_oklab,var(--color-ink)_6%,transparent)] bg-[color-mix(in_oklab,var(--color-sand)_72%,var(--color-paper))] px-2 py-4 md:rounded-[1.5rem] md:px-4 md:py-5"
        />
      </div>
    </div>
  </section>
)}
