---
import AppIcon from '@components/ui/AppIcon.astro';
---

<button
  type="button"
  data-theme-toggle
  class="inline-flex h-9 w-9 items-center justify-center rounded-full text-ink hover:bg-sand"
  aria-label="Cambiar tema"
>
  <span class="theme-icon-moon">
    <AppIcon name="moon" size={16} />
  </span>
  <span class="theme-icon-sun">
    <AppIcon name="sun" size={16} />
  </span>
</button>
