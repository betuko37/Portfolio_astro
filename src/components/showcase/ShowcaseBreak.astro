---
import type { IconName } from '@data/icons';
import AppIcon from '@components/ui/AppIcon.astro';
import FoldText from '@components/effects/fold-text/FoldText.jsx';

interface Props {
  kicker: string;
  title: string;
  copy?: string;
  icon: IconName;
  tone?: 'sand' | 'ink';
}

const { kicker, title, copy, icon, tone = 'sand' } = Astro.props;
const inverted = tone === 'ink';
---

<div
  class:list={[
    'overflow-hidden rounded-[1.5rem] px-5 py-8 md:rounded-[2rem] md:px-10 md:py-12',
    inverted ? 'tone-ink' : 'bg-sand text-ink',
  ]}
>
  <div class="flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-start">
    <div class="min-w-0">
      <p
        class:list={[
          'inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] md:text-sm',
          inverted ? 'text-accent-soft' : 'text-accent',
        ]}
      >
        <AppIcon name={icon} size={14} />
        {kicker}
      </p>
      <h2 class="mt-2 max-w-2xl font-display text-2xl tracking-tight md:text-4xl">
        <FoldText
          client:visible
          text={title}
          splitBy="word"
          hinge="top"
          trigger="scroll"
          color="currentColor"
          fontSize="inherit"
          fontWeight={700}
        />
      </h2>
    </div>
    <div class="shrink-0 empty:hidden">
      <slot name="action" />
    </div>
  </div>
  {copy && (
    <p class:list={['mt-3 max-w-xl text-sm leading-relaxed md:text-base', inverted ? 'opacity-80' : 'text-muted']}>
      {copy}
    </p>
  )}
  <div class="mt-6 empty:hidden md:mt-8">
    <slot />
  </div>
</div>
