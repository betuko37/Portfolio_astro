---
import type { ShowcaseGroup, ShowcaseItem } from '@data/showcase';
import type { IconName } from '@data/icons';
import AppIcon from '@components/ui/AppIcon.astro';
import ShowcaseCard from '@components/showcase/ShowcaseCard.astro';
import FoldText from '@components/effects/fold-text/FoldText.jsx';

interface Props {
  id: ShowcaseGroup;
  title: string;
  kicker: string;
  icon: IconName;
  items: ShowcaseItem[];
}

const { id, title, kicker, icon, items } = Astro.props;
---

{items.length > 0 && (
  <div id={id} data-rail>
    <div class="mb-4">
      <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-accent md:text-sm">
        <AppIcon name={icon} size={14} />
        {kicker}
      </p>
      <div class="mt-1 flex items-center justify-between gap-3">
        <div class="flex min-w-0 flex-1 items-center gap-2 sm:gap-3">
          <h3 class="min-w-0 font-display text-xl tracking-tight md:text-3xl">
            <FoldText
              client:visible
              text={title}
              splitBy="word"
              hinge="top"
              trigger="scroll"
              color="currentColor"
              fontSize="inherit"
              fontWeight={700}
            />
          </h3>
          <a
            href={`/proyectos?grupo=${id}`}
            class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-ink px-3 py-1.5 text-xs font-medium text-paper no-underline md:px-3.5 md:py-2 md:text-sm"
          >
            Ver listado
            <AppIcon name="arrow-right" size={14} />
          </a>
        </div>
        {items.length > 1 && (
          <div class="flex shrink-0 items-center gap-1.5">
            <button
              class="btn-accent rail-prev inline-flex h-9 w-9 items-center justify-center rounded-full"
              type="button"
              aria-label="Anterior"
            >
              <AppIcon name="arrow-right" size={14} class="rotate-180" />
            </button>
            <button
              class="btn-accent rail-next inline-flex h-9 w-9 items-center justify-center rounded-full"
              type="button"
              aria-label="Siguiente"
            >
              <AppIcon name="arrow-right" size={14} />
            </button>
          </div>
        )}
      </div>
    </div>

    <div class="rail">
      {items.map((item) => (
        <div class="rail-item">
          <ShowcaseCard item={item} />
        </div>
      ))}
    </div>
  </div>
)}
