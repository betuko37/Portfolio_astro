---
import type { ShowcaseGroup, ShowcaseItem } from '@data/showcase';
import type { IconName } from '@data/icons';
import AppIcon from '@components/ui/AppIcon.astro';
import ShowcaseCard from '@components/showcase/ShowcaseCard.astro';
import FoldText from '@components/effects/fold-text/FoldText.jsx';

interface Props {
  id: ShowcaseGroup;
  title: string;
  kicker: string;
  icon: IconName;
  items: ShowcaseItem[];
}

const { id, title, kicker, icon, items } = Astro.props;
---

{items.length > 0 && (
  <div id={id} data-rail>
    <div class="mb-4 flex items-end justify-between gap-3">
      <div>
        <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-accent md:text-sm">
          <AppIcon name={icon} size={14} />
          {kicker}
        </p>
        <h3 class="mt-1 font-display text-xl tracking-tight md:text-3xl">
          <FoldText
            client:visible
            text={title}
            splitBy="word"
            hinge="top"
            trigger="scroll"
            color="currentColor"
            fontSize="inherit"
            fontWeight={700}
          />
        </h3>
      </div>
      <div class="flex shrink-0 items-center gap-1.5">
        {items.length > 1 && (
          <>
            <button
              class="rail-prev inline-flex h-9 w-9 items-center justify-center rounded-full bg-sand text-ink hover:bg-accent-soft"
              type="button"
              aria-label="Anterior"
            >
              <AppIcon name="arrow-right" size={14} class="rotate-180" />
            </button>
            <button
              class="rail-next inline-flex h-9 w-9 items-center justify-center rounded-full bg-sand text-ink hover:bg-accent-soft"
              type="button"
              aria-label="Siguiente"
            >
              <AppIcon name="arrow-right" size={14} />
            </button>
          </>
        )}
        <a
          href={`/proyectos?grupo=${id}`}
          class="inline-flex items-center gap-1.5 rounded-full bg-sand px-3.5 py-2 text-xs font-medium text-ink no-underline hover:bg-accent-soft md:text-sm"
        >
          Ver listado
          <AppIcon name="arrow-right" size={14} />
        </a>
      </div>
    </div>

    <div class="rail">
      {items.map((item) => (
        <div class="rail-item">
          <ShowcaseCard item={item} />
        </div>
      ))}
    </div>
  </div>
)}
