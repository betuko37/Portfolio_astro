---
import type { ShowcaseItem } from '@data/showcase';
import AppIcon from '@components/ui/AppIcon.astro';
import BrandIcon from '@components/ui/BrandIcon.astro';
import { isBrandImage } from '@data/brands';

interface Props {
  item: ShowcaseItem;
}

const { item } = Astro.props;
const Tag = item.href ? 'a' : 'article';
const stack = item.stack.slice(0, 5);
const extra = item.stack.length - stack.length;
---

<Tag
  {...(item.href
    ? {
        href: item.href,
        target: item.external ? '_blank' : undefined,
        rel: item.external ? 'noreferrer' : undefined,
      }
    : {})}
  class="flex h-full min-h-[210px] flex-col justify-between rounded-[1.4rem] bg-sand p-4 text-ink no-underline md:min-h-[230px] md:p-5"
>
  <div>
    <div class="mb-3 flex items-start justify-between gap-2">
      <span class="inline-flex h-10 w-10 items-center justify-center overflow-hidden rounded-2xl bg-paper p-1.5">
        {item.logo ? (
          <img src={item.logo} alt="" class="h-full w-full object-contain" />
        ) : (
          <AppIcon name={item.icon} size={20} />
        )}
      </span>
      {item.live && (
        <span class="live-badge px-2 py-0.5 text-[10px] tracking-wide">
          <span class="live-dot"></span>
          En vivo
        </span>
      )}
    </div>
    <p class="flex flex-wrap items-center gap-1.5 text-[11px] text-muted">
      <span>{item.kicker}</span>
      <span class="rounded-full bg-paper px-1.5 py-0.5 font-medium tabular-nums">{item.year.replace(' — ', '–')}</span>
    </p>
    <h3 class="mt-1.5 font-display text-lg tracking-tight">{item.title}</h3>
    <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted">{item.tagline}</p>
  </div>
  <div class="mt-4 flex items-end justify-between gap-3">
    {stack.length > 0 && (
      <ul class="flex flex-wrap items-center gap-1">
        {stack.map((tech) => (
          <li
            class:list={[
              'inline-flex items-center justify-center rounded-full bg-paper',
              isBrandImage(tech) ? 'h-8 w-8' : 'h-7 w-7',
            ]}
            title={tech}
          >
            <BrandIcon label={tech} size={isBrandImage(tech) ? 16 : 13} />
          </li>
        ))}
        {extra > 0 && (
          <li class="inline-flex h-7 min-w-7 items-center justify-center rounded-full bg-paper px-1 text-[10px] text-muted">
            +{extra}
          </li>
        )}
      </ul>
    )}
    <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-ink/80 px-3 py-1.5 text-[11px] font-medium text-paper">
      Estudio de caso
      <AppIcon name="arrow-right" size={13} />
    </span>
  </div>
</Tag>
