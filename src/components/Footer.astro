---
import { profile, whatsappHref } from '../data/profile';

const year = new Date().getFullYear();
const whatsapp = profile.whatsapp ? whatsappHref(profile.whatsapp) : '';
---

<footer class="px-5 py-10 md:px-8">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-sm font-semibold">{profile.name}</p>
      <p class="mt-1 text-sm text-muted">{profile.role}</p>
    </div>
    <div class="flex flex-wrap gap-2 text-sm">
      <a class="rounded-full bg-sand px-3.5 py-1.5 no-underline hover:bg-accent-soft" href={profile.github}>GitHub</a>
      {profile.linkedin && (
        <a class="rounded-full bg-sand px-3.5 py-1.5 no-underline hover:bg-accent-soft" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      )}
      {whatsapp && (
        <a class="rounded-full bg-sand px-3.5 py-1.5 no-underline hover:bg-accent-soft" href={whatsapp} target="_blank" rel="noreferrer">WhatsApp</a>
      )}
      <a class="rounded-full bg-sand px-3.5 py-1.5 no-underline hover:bg-accent-soft" href={`mailto:${profile.email}`}>Email</a>
    </div>
    <p class="text-xs text-muted">© {year} {profile.name}</p>
  </div>
</footer>
