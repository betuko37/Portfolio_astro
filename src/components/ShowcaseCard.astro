---
import type { ShowcaseItem } from '../data/showcase';
import { getBrandColor } from '../data/brands';
import AppIcon from './AppIcon.astro';
import BrandIcon from './BrandIcon.astro';

interface Props {
  item: ShowcaseItem;
}

const { item } = Astro.props;
const Tag = item.href ? 'a' : 'article';
const stack = item.stack.slice(0, 4);
const extra = item.stack.length - stack.length;
const raw = item.stack[0] ? getBrandColor(item.stack[0]) : '#7c3aed';
const mark = raw === 'currentColor' ? '#7c3aed' : raw;
---

<Tag
  {...(item.href
    ? {
        href: item.href,
        target: item.external ? '_blank' : undefined,
        rel: item.external ? 'noreferrer' : undefined,
      }
    : {})}
  class="relative flex h-full min-h-[210px] flex-col justify-between overflow-hidden rounded-[1.4rem] bg-sand p-4 pl-5 text-ink no-underline md:min-h-[230px] md:p-5 md:pl-6"
>
  <span class="absolute inset-y-0 left-0 w-1.5" style={`background:${mark}`}></span>
  <div>
    <div class="mb-3 flex items-start justify-between gap-2">
      <span
        class="inline-flex h-10 w-10 items-center justify-center overflow-hidden rounded-2xl p-1.5"
        style={`background: color-mix(in srgb, ${mark} 16%, var(--color-paper));`}
      >
        {item.logo ? (
          <img src={item.logo} alt="" class="h-full w-full object-contain" />
        ) : (
          <AppIcon name={item.icon} size={20} />
        )}
      </span>
      {item.live && (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-ink px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-paper">
          <span class="live-dot"></span>
          En vivo
        </span>
      )}
    </div>
    <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted">
      {item.kicker} · {item.year}
    </p>
    <h3 class="mt-1.5 font-display text-lg tracking-tight">{item.title}</h3>
    <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted">{item.tagline}</p>
  </div>
  <div class="mt-4">
    {stack.length > 0 && (
      <ul class="mb-3 flex flex-wrap gap-1">
        {stack.map((tech) => (
          <li class="inline-flex items-center gap-1 rounded-full bg-paper px-1.5 py-0.5 text-[10px] text-muted">
            <BrandIcon label={tech} size={10} />
            <span>{tech}</span>
          </li>
        ))}
        {extra > 0 && (
          <li class="inline-flex items-center rounded-full bg-paper px-1.5 py-0.5 text-[10px] text-muted">
            +{extra}
          </li>
        )}
      </ul>
    )}
    <p class="inline-flex items-center gap-1.5 text-xs font-medium text-accent">
      Ver case study
      <AppIcon name="arrow-right" size={14} />
    </p>
  </div>
</Tag>
