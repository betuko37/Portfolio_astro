---
import type { Lab } from '../data/labs';
import { getRelatedLabs, labLinks } from '../data/labs';
import { fromLab } from '../data/showcase';
import AppIcon from './AppIcon.astro';
import BackLink from './BackLink.astro';
import StackPills from './StackPills.astro';
import ShowcaseCard from './ShowcaseCard.astro';

interface Props {
  lab: Lab;
}

const { lab } = Astro.props;
const links = labLinks(lab);
const related = getRelatedLabs(lab.slug);
const facts = [
  lab.live ? 'Demostración en línea' : null,
  lab.github ? 'Repositorio público' : null,
  lab.fromCv ? 'Práctica profesional' : null,
].filter((item): item is string => Boolean(item));
---

<article>
  <header class="px-4 pt-3 md:px-8">
    <div class="mx-auto mb-3 max-w-6xl">
      <BackLink href="/#proyectos" />
    </div>
    <div class="tone-night relative mx-auto max-w-6xl overflow-hidden rounded-[1.5rem] px-5 py-8 md:rounded-[2rem] md:px-12 md:py-20" data-hero>
      <div class="relative">
        <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-paper/10 md:mb-6 md:h-16 md:w-16" data-hero-item>
          <AppIcon name={lab.icon} size={36} />
        </div>
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent-soft md:text-sm" data-hero-item>
          {lab.kicker} · {lab.year}
        </p>
        <h1 class="mt-3 max-w-4xl font-display text-3xl tracking-tight md:text-6xl">
          {lab.title}
        </h1>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-mist md:mt-5 md:text-xl" data-hero-item>
          {lab.tagline}
        </p>
        {facts.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2" data-hero-item>
            {facts.map((fact) => (
              <span class="rounded-full bg-paper/10 px-3 py-1 text-xs text-mist">{fact}</span>
            ))}
          </div>
        )}
        {links.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3" data-hero-item>
            {links.map((link) => (
              <a
                class="inline-flex items-center gap-2 rounded-full bg-paper px-4 py-2.5 text-sm font-medium text-ink no-underline hover:bg-accent-soft"
                href={link.href}
                target="_blank"
                rel="noreferrer"
                data-magnetic
              >
                {link.label}
                <AppIcon name="arrow-up-right" size={14} />
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </header>

  <section class="px-4 py-10 md:px-8 md:py-16">
    <div class="mx-auto max-w-6xl" data-reveal>
      <p class="inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-accent">
        <AppIcon name="sparkles" size={14} />
        Descripción
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed md:text-base">{lab.tagline}</p>
    </div>
  </section>

  <section class="px-5 pb-16 md:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-accent">
        <AppIcon name="cpu" size={14} />
        Stack
      </p>
      <div class="mt-5">
        <StackPills items={lab.stack} />
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="px-5 pb-20 md:px-8">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-muted">Proyectos relacionados</p>
        <div class="mt-6 grid gap-3 md:grid-cols-3">
          {related.map((item) => (
            <ShowcaseCard item={fromLab(item)} />
          ))}
        </div>
      </div>
    </section>
  )}
</article>
