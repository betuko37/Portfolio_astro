---
import { profile } from '../data/profile';
import { focusIcons } from '../data/icons';
import { profilePhoto } from '../data/media';
import AppIcon from './AppIcon.astro';
---

<section id="sobre" class="px-4 py-4 md:px-8 md:py-8">
  <div class="mx-auto grid max-w-6xl gap-3 md:grid-cols-12 md:gap-4">
    <div class="overflow-hidden rounded-[1.5rem] bg-sand md:col-span-5 md:rounded-[2rem]" data-reveal>
      <img
        src={profilePhoto}
        alt={profile.name}
        class="aspect-[4/5] h-full max-h-64 w-full object-cover object-top md:max-h-none md:min-h-[400px]"
      />
    </div>

    <div class="flex flex-col justify-between rounded-[1.5rem] bg-sand px-5 py-7 md:col-span-7 md:rounded-[2rem] md:px-10 md:py-12" data-reveal>
      <div>
        <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-accent md:text-sm">
          <AppIcon name="user-round" size={14} />
          Sobre mí
        </p>
        <h2 class="mt-2 font-display text-2xl tracking-tight md:text-4xl">{profile.name}</h2>
        <p class="mt-2 inline-flex items-center gap-2 text-xs text-muted md:text-sm">
          <span class="live-dot text-accent"></span>
          {profile.availability}
        </p>
        <div class="mt-5 space-y-4 text-sm leading-relaxed md:mt-8 md:text-base">
          {profile.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div class="mt-8 flex flex-wrap gap-2">
        {focusIcons.map((item) => (
          <span class="inline-flex items-center gap-2 rounded-full bg-paper px-3.5 py-1.5 text-sm">
            <AppIcon name={item.icon} size={14} />
            {item.label}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
