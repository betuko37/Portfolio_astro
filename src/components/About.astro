---
import { profile } from '../data/profile';
import { focusIcons } from '../data/icons';
import AppIcon from './AppIcon.astro';
import MexicoFlag from './MexicoFlag.astro';
import FoldText from './FoldText.jsx';
---

<section id="sobre" class="px-4 py-4 md:px-8 md:py-8">
  <div class="mx-auto grid max-w-6xl gap-3 md:grid-cols-12 md:gap-4">
    <div
      class="relative min-h-[260px] overflow-hidden rounded-[1.5rem] bg-sand md:col-span-5 md:min-h-[440px] md:rounded-[2rem]"
      data-reveal
      data-hero-stage
    >
      <canvas class="absolute inset-0 h-full w-full" data-hero-canvas aria-hidden="true"></canvas>
      <p class="pointer-events-none absolute inset-x-0 bottom-4 text-center text-[10px] font-medium uppercase tracking-[0.16em] text-muted sm:bottom-5 sm:text-xs">
        Ingeniero de software
      </p>
    </div>

    <div class="flex flex-col justify-between rounded-[1.5rem] bg-sand px-5 py-7 md:col-span-7 md:rounded-[2rem] md:px-10 md:py-12">
      <div>
        <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-accent md:text-sm">
          <AppIcon name="user-round" size={14} />
          Sobre mí
        </p>
        <h2 class="mt-2 font-display text-2xl tracking-tight md:text-4xl">
          <FoldText
            client:visible
            text={profile.name}
            splitBy="char"
            hinge="top"
            trigger="scroll"
            color="currentColor"
            fontSize="inherit"
            fontWeight={700}
          />
        </h2>
        <p class="mt-2 inline-flex flex-wrap items-center gap-2 text-xs text-muted md:text-sm">
          <MexicoFlag />
          <span>{profile.role}</span>
          <span>·</span>
          <span>{profile.location}</span>
        </p>
        <p class="mt-2 inline-flex items-center gap-2 text-xs text-muted md:text-sm">
          <span class="live-dot text-accent"></span>
          {profile.availability}
        </p>
        <div class="mt-5 space-y-4 text-sm leading-relaxed md:mt-8 md:text-base">
          {profile.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <div>
        <div class="mt-8 flex flex-wrap gap-2">
          {focusIcons.map((item) => (
            <span class="inline-flex items-center gap-2 rounded-full bg-paper px-3.5 py-1.5 text-sm">
              <AppIcon name={item.icon} size={14} />
              {item.label}
            </span>
          ))}
        </div>
        <a
          href="/sobre"
          class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-ink px-4 py-2.5 text-sm font-medium text-paper no-underline"
        >
          Ver perfil
          <AppIcon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroScene } from '../scripts/heroScene';
  initHeroScene();
</script>
