---
import { getFeaturedProjects, projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

const featured = getFeaturedProjects();
const rest = projects.filter((project) => !project.featured);
---

<section id="proyectos" class="px-5 py-14 md:px-8 md:py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">Proyectos</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight md:text-4xl">
      Los que cargan la sabiduría. Sistemas grandes, no demos.
    </h2>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {featured.map((project, index) => (
        <div class:list={[index === 0 && 'md:col-span-2']}>
          <ProjectCard project={project} large={index === 0} />
        </div>
      ))}
    </div>

    {rest.length > 0 && (
      <div class="mt-14">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-muted">
          Case studies del ecosistema
        </p>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {rest.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </div>
    )}
  </div>
</section>
