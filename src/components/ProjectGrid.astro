---
import { getShowcase, showcaseSections } from '../data/showcase';
import ShowcaseRail from './ShowcaseRail.astro';
import AppIcon from './AppIcon.astro';
---

<section id="proyectos" class="px-4 py-10 md:px-8 md:py-20">
  <div class="mx-auto max-w-6xl">
    <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-accent md:text-sm" data-reveal>
      <AppIcon name="folder-kanban" size={14} />
      Proyectos
    </p>
    <h2 class="mt-2 max-w-2xl font-display text-2xl tracking-tight md:text-4xl lg:text-5xl" data-reveal>
      En vivo, en GitHub y del CV.
    </h2>

    {showcaseSections.map((section) => (
      <ShowcaseRail
        id={section.id}
        title={section.title}
        kicker={section.kicker}
        icon={section.icon}
        items={getShowcase(section.id)}
      />
    ))}
  </div>
</section>
