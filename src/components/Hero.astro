---
import { profile } from '../data/profile';
---

<section class="px-5 pb-12 pt-10 md:px-8 md:pb-16 md:pt-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">
      {profile.role} · {profile.location}
    </p>
    <h1 class="mt-5 max-w-4xl text-4xl font-semibold leading-[1.08] tracking-tight md:text-6xl">
      {profile.headline}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">
      {profile.summary}
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="#proyectos"
        class="tone-ink rounded-full px-6 py-3 text-sm font-medium no-underline hover:bg-accent"
      >
        Ver proyectos
      </a>
      <a
        href="#contacto"
        class="rounded-full bg-sand px-6 py-3 text-sm font-medium text-ink no-underline hover:bg-accent-soft"
      >
        Contactar
      </a>
    </div>
  </div>
</section>
