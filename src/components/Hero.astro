---
import { profile } from '../data/profile';
import { getFeaturedProjects } from '../data/projects';
import { projectIcons } from '../data/icons';
import { profilePhoto, getProjectLogo } from '../data/media';
import AppIcon from './AppIcon.astro';

const featured = getFeaturedProjects();
const words = profile.headline.split(' ');
const punchFrom = 5;
---

<section class="px-4 pb-8 pt-4 md:px-8 md:pb-14 md:pt-8">
  <div class="mx-auto grid max-w-6xl items-center gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12" data-hero>
    <div>
      <p
        class="inline-flex items-center gap-2 rounded-full bg-sand px-3 py-1 text-[10px] font-medium uppercase tracking-[0.14em] text-accent sm:text-xs"
        data-hero-item
      >
        <span class="live-dot text-accent"></span>
        <span class="sm:hidden">{profile.location} · Disponible</span>
        <span class="hidden sm:inline">{profile.location} · {profile.availability}</span>
      </p>

      <h1 class="mt-4 max-w-4xl font-display text-[1.5rem] leading-[1.2] sm:text-3xl md:mt-6 md:text-5xl lg:text-6xl">
        {words.map((word, index) => (
          <span class="split-word">
            <span class:list={['split-inner', index >= punchFrom && 'italic text-accent']}>
              {word}
            </span>
          </span>
        ))}
      </h1>

      <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted md:mt-6 md:text-base lg:text-lg" data-hero-item>
        {profile.summary}
      </p>

      <div class="mt-6 flex flex-wrap gap-2.5 md:mt-8" data-hero-item>
        <a
          href="#proyectos"
          data-magnetic
          class="tone-ink inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-sm font-medium no-underline hover:bg-accent md:px-5"
        >
          Ver proyectos
          <AppIcon name="arrow-right" size={16} />
        </a>
        <a
          href="#contacto"
          data-magnetic
          class="inline-flex items-center gap-2 rounded-full bg-sand px-4 py-2.5 text-sm font-medium text-ink no-underline hover:bg-accent-soft md:px-5"
        >
          Contactar
          <AppIcon name="send" size={16} />
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 grid-rows-3 gap-2 sm:gap-3 sm:grid-rows-[minmax(0,1fr)_120px_120px] lg:min-h-[440px]">
      <div class="relative row-span-2 min-h-[150px] overflow-hidden rounded-[1.4rem] bg-sand md:min-h-[200px] md:rounded-[2rem]" data-hero-icon>
        <span class="photo-pulse pointer-events-none absolute inset-2 rounded-[1.1rem] bg-accent/20 md:inset-3 md:rounded-[1.6rem]"></span>
        <img
          src={profilePhoto}
          alt={profile.name}
          class="relative z-[1] h-full w-full object-cover object-top"
        />
        <span
          class="photo-ring pointer-events-none absolute -right-8 -top-8 h-24 w-24 rounded-full"
          style="background: conic-gradient(from 90deg, transparent 0 70%, #7c3aed 70% 100%)"
        ></span>
      </div>

      {featured.map((project) => (
        <a
          href={`/proyectos/${project.slug}`}
          data-hero-icon
          data-float
          class:list={[
            'flex min-h-[4.5rem] flex-col justify-between rounded-[1.2rem] p-3 no-underline sm:min-h-24 sm:rounded-[1.6rem] sm:p-4',
            `tone-${project.accent}`,
          ]}
        >
          {getProjectLogo(project.slug) ? (
            <img src={getProjectLogo(project.slug)} alt="" class="h-6 w-6 object-contain sm:h-8 sm:w-8" />
          ) : (
            <AppIcon name={projectIcons[project.slug]} size={20} />
          )}
          <span class="text-[11px] font-medium leading-tight sm:text-sm">{project.title}</span>
        </a>
      ))}
    </div>
  </div>
</section>
