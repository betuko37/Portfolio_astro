---
import type { Project } from '../data/projects';
import { iconForModule } from '../data/icons';
import AppIcon from './AppIcon.astro';
import StackMarquee from './StackMarquee.astro';
import ArchViewer from './ArchViewer.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;

function splitLine(text: string, fallback: string) {
  const colon = text.match(/^([^:]{6,52}):\s+(.+)$/);
  if (colon) return { title: colon[1], body: colon[2] };
  return { title: fallback, body: text };
}
---

<div class="space-y-6 md:space-y-8">
  <div class="grid items-stretch gap-3 md:grid-cols-2">
    <article class="flex h-full flex-col rounded-[1.4rem] bg-sand p-5">
      <span class="mb-3 inline-flex w-fit rounded-2xl bg-paper p-2 text-accent">
        <AppIcon name="circle-alert" size={18} />
      </span>
      <h3 class="font-display text-lg font-semibold tracking-tight">Contexto</h3>
      <p class="mt-2 text-sm leading-relaxed text-muted">{project.problem}</p>
    </article>
    <article class="flex h-full flex-col rounded-[1.4rem] bg-sand p-5">
      <span class="mb-3 inline-flex w-fit rounded-2xl bg-paper p-2 text-accent">
        <AppIcon name="sparkles" size={18} />
      </span>
      <h3 class="font-display text-lg font-semibold tracking-tight">Descripción</h3>
      <p class="mt-2 text-sm leading-relaxed text-muted">{project.summary}</p>
    </article>
  </div>

  {project.modules.length > 0 && (
    <section data-rail>
      <div class="mb-4 flex items-end justify-between gap-3">
        <p class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-accent">
          <AppIcon name="layers" size={14} />
          Módulos
        </p>
        {project.modules.length > 1 && (
          <div class="flex gap-1.5">
            <button class="rail-prev inline-flex h-9 w-9 items-center justify-center rounded-full bg-sand text-ink hover:bg-accent-soft" type="button" aria-label="Anterior">
              <AppIcon name="arrow-right" size={14} class="rotate-180" />
            </button>
            <button class="rail-next inline-flex h-9 w-9 items-center justify-center rounded-full bg-sand text-ink hover:bg-accent-soft" type="button" aria-label="Siguiente">
              <AppIcon name="arrow-right" size={14} />
            </button>
          </div>
        )}
      </div>
      <div class="rail">
        {project.modules.map((module) => (
          <article class="rail-item rounded-[1.4rem] bg-sand p-5">
            <span class="mb-3 inline-flex w-fit rounded-2xl bg-paper p-2 text-accent">
              <AppIcon name={iconForModule(module.name)} size={18} />
            </span>
            <h3 class="font-display text-lg font-semibold tracking-tight">{module.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{module.description}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {(project.architectureLayers || project.architecture) && (
    <ArchViewer
      chart={project.architecture}
      layers={project.architectureLayers}
    />
  )}

  {project.stack.length > 0 && (
    <section class="overflow-hidden rounded-[1.4rem] bg-sand px-5 py-6 md:px-6">
      <p class="mb-4 inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-accent">
        <AppIcon name="cpu" size={14} />
        Stack
      </p>
      <StackMarquee items={project.stack} single />
    </section>
  )}

  {project.howItWorks.length > 0 && (
    <section data-rail>
      <div class="mb-4 flex items-end justify-between gap-3">
        <p class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-accent">
          <AppIcon name="waypoints" size={14} />
          Proceso
        </p>
        {project.howItWorks.length > 1 && (
          <div class="flex gap-1.5">
            <button class="rail-prev inline-flex h-9 w-9 items-center justify-center rounded-full bg-sand text-ink hover:bg-accent-soft" type="button" aria-label="Anterior">
              <AppIcon name="arrow-right" size={14} class="rotate-180" />
            </button>
            <button class="rail-next inline-flex h-9 w-9 items-center justify-center rounded-full bg-sand text-ink hover:bg-accent-soft" type="button" aria-label="Siguiente">
              <AppIcon name="arrow-right" size={14} />
            </button>
          </div>
        )}
      </div>
      <div class="rail">
        {project.howItWorks.map((step, index) => {
          const n = String(index + 1).padStart(2, '0');
          const card = splitLine(step, `Paso ${n}`);
          return (
            <article class="rail-item rounded-[1.4rem] bg-sand p-5">
              <span class="mb-3 inline-flex h-9 w-fit min-w-9 items-center justify-center rounded-2xl bg-paper px-2.5 font-display text-sm font-semibold text-accent">
                {n}
              </span>
              <h3 class="font-display text-lg font-semibold tracking-tight">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{card.body}</p>
            </article>
          );
        })}
      </div>
    </section>
  )}

  {project.highlights.length > 0 && (
    <section data-rail>
      <div class="mb-4 flex items-end justify-between gap-3">
        <p class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-accent">
          <AppIcon name="sparkles" size={14} />
          Resultados
        </p>
        {project.highlights.length > 1 && (
          <div class="flex gap-1.5">
            <button class="rail-prev inline-flex h-9 w-9 items-center justify-center rounded-full bg-sand text-ink hover:bg-accent-soft" type="button" aria-label="Anterior">
              <AppIcon name="arrow-right" size={14} class="rotate-180" />
            </button>
            <button class="rail-next inline-flex h-9 w-9 items-center justify-center rounded-full bg-sand text-ink hover:bg-accent-soft" type="button" aria-label="Siguiente">
              <AppIcon name="arrow-right" size={14} />
            </button>
          </div>
        )}
      </div>
      <div class="rail">
        {project.highlights.map((item, index) => {
          const card = splitLine(item, `Resultado ${String(index + 1).padStart(2, '0')}`);
          return (
            <article class="rail-item rounded-[1.4rem] bg-sand p-5">
              <span class="mb-3 inline-flex w-fit rounded-2xl bg-paper p-2 text-accent">
                <AppIcon name={iconForModule(item)} size={18} />
              </span>
              <h3 class="font-display text-lg font-semibold tracking-tight">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{card.body}</p>
            </article>
          );
        })}
      </div>
    </section>
  )}
</div>
