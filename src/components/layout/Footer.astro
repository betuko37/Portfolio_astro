---
import { profile, whatsappHref } from '@data/profile';
import AppIcon from '@components/ui/AppIcon.astro';
import ProfilePhoto from '@components/ui/ProfilePhoto.astro';
import type { IconName } from '@data/icons';

const year = new Date().getFullYear();
const whatsapp = profile.whatsapp ? whatsappHref(profile.whatsapp) : '';

const socials: { href: string; label: string; icon: IconName }[] = [
  { href: profile.github, label: 'GitHub', icon: 'github' },
];
if (profile.linkedin) socials.push({ href: profile.linkedin, label: 'LinkedIn', icon: 'linkedin' });
if (whatsapp) socials.push({ href: whatsapp, label: 'WhatsApp', icon: 'whatsapp' });
socials.push({ href: `mailto:${profile.email}`, label: 'Email', icon: 'mail' });
---

<footer class="relative z-[1] px-4 pb-[calc(5.5rem+env(safe-area-inset-bottom))] pt-4 sm:pb-10 md:px-8">
  <div class="relative mx-auto flex max-w-6xl items-center justify-between gap-3 overflow-hidden rounded-[1.5rem] bg-sand px-4 py-3 text-ink md:rounded-[2rem] md:px-7 md:py-5">
    <span class="pointer-events-none absolute -right-16 top-1/2 h-32 w-32 -translate-y-1/2 rounded-full bg-accent/20 blur-3xl"></span>

    <a href="/sobre" class="relative flex min-w-0 items-center gap-3 no-underline" data-magnetic>
      <span class="inline-flex shrink-0 rounded-full p-[2px] ring-1 ring-ink/10">
        <ProfilePhoto class="w-11 md:w-12" />
      </span>
      <span class="min-w-0">
        <span class="block truncate font-display text-base tracking-tight md:text-lg">{profile.name}</span>
        <span class="block truncate text-xs text-muted">{profile.handle}</span>
      </span>
    </a>

    <div class="relative flex items-center gap-1.5">
      {socials.map((item) => (
        <a
          class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-paper text-ink no-underline transition-colors hover:bg-accent hover:text-white"
          href={item.href}
          target={item.href.startsWith('http') ? '_blank' : undefined}
          rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
          aria-label={item.label}
          data-magnetic
        >
          <AppIcon name={item.icon} size={15} />
        </a>
      ))}
    </div>

    <p class="relative shrink-0 text-[11px] text-muted md:text-xs">
      <span class="sm:hidden">© {year}</span>
      <span class="hidden sm:inline">© {year} {profile.fullName}</span>
    </p>
  </div>
</footer>
