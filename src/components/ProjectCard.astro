---
import { getLiveLink, type Project } from '../data/projects';

interface Props {
  project: Project;
  large?: boolean;
}

const { project, large = false } = Astro.props;
const live = getLiveLink(project);
const isLight = project.accent === 'sand';
---

<a
  href={`/proyectos/${project.slug}`}
  class:list={[
    'group flex h-full flex-col justify-between rounded-3xl p-6 no-underline md:p-8',
    `tone-${project.accent}`,
    large ? 'min-h-[320px] md:min-h-[400px]' : 'min-h-[240px]',
  ]}
>
  <div>
    <div class="flex flex-wrap items-center gap-2">
      <p class="text-xs font-medium uppercase tracking-[0.16em] opacity-70">{project.kicker}</p>
      {live && (
        <span
          class:list={[
            'rounded-full px-2.5 py-0.5 text-[11px] font-medium uppercase tracking-wide',
            isLight ? 'bg-ink text-[#f6f3ec]' : 'bg-[#f6f3ec] text-[#161616]',
          ]}
        >
          En vivo
        </span>
      )}
    </div>
    <h3 class="mt-3 text-2xl font-semibold tracking-tight md:text-3xl">{project.title}</h3>
    <p class="mt-3 max-w-xl text-base leading-relaxed opacity-85">{project.tagline}</p>
  </div>
  <p class="mt-8 text-sm font-medium">
    Ver case study
    <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
  </p>
</a>
