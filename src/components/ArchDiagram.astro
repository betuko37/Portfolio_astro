---
interface Props {
  chart: string;
  large?: boolean;
}

const { chart, large = false } = Astro.props;
---

<div class:list={["mer-wrap mx-auto w-full overflow-x-auto", large ? "max-w-6xl" : "max-w-3xl"]}>
  <pre class:list={["mermaid", large && "is-large"]}>{chart}</pre>
</div>

<style>
  .mermaid.is-large {
    font-size: 1.05rem;
  }

  .mer-wrap:has(.is-large) :global(svg) {
    max-width: none !important;
    width: 100% !important;
    height: auto !important;
  }
</style>
