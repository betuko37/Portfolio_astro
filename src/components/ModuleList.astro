---
import type { ProjectModule } from '../data/projects';
import { iconForModule } from '../data/icons';
import AppIcon from './AppIcon.astro';

interface Props {
  modules: ProjectModule[];
}

const { modules } = Astro.props;
---

<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {modules.map((module) => (
    <article class="rounded-[1.5rem] bg-sand p-5 md:p-6" data-reveal>
      <span class="mb-3 inline-flex rounded-2xl bg-paper p-2.5 text-accent">
        <AppIcon name={iconForModule(module.name)} size={20} />
      </span>
      <h3 class="text-lg font-semibold tracking-tight">{module.name}</h3>
      <p class="mt-2 text-sm leading-relaxed text-muted">{module.description}</p>
    </article>
  ))}
</div>
