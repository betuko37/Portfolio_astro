---
import { profile, whatsappHref } from '../data/profile';

const mailHref = `mailto:${profile.email}?subject=${encodeURIComponent('Contacto desde el portafolio')}`;
const whatsapp = profile.whatsapp ? whatsappHref(profile.whatsapp) : '';
---

<section id="contacto" class="px-5 py-6 md:px-8 md:py-8">
  <div class="mx-auto max-w-6xl rounded-3xl bg-night px-6 py-12 text-paper md:px-12 md:py-16">
    <div class="grid gap-12 md:grid-cols-[1fr_1fr]">
      <div>
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent-soft">Contacto</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">
          Escribe, llama o abre un issue. Respondo.
        </h2>
        <p class="mt-4 max-w-md text-sand">
          {profile.availability}
        </p>
        <div class="mt-8 flex flex-col gap-3 text-lg">
          <a class="w-fit rounded-full no-underline hover:text-accent-soft" href={mailHref}>{profile.email}</a>
          <a class="w-fit rounded-full no-underline hover:text-accent-soft" href={profile.github}>github.com/{profile.githubUser}</a>
          {profile.linkedin && (
            <a class="w-fit rounded-full no-underline hover:text-accent-soft" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          )}
          {whatsapp && (
            <a class="w-fit rounded-full no-underline hover:text-accent-soft" href={whatsapp} target="_blank" rel="noreferrer">WhatsApp</a>
          )}
        </div>
      </div>

      <form class="flex flex-col gap-4" action={mailHref} method="get">
        <label class="text-sm text-sand">
          Nombre
          <input
            class="mt-2 w-full rounded-2xl bg-night-soft px-4 py-3 text-paper outline-none placeholder:text-sand"
            type="text"
            name="name"
            required
            placeholder="Tu nombre"
          />
        </label>
        <label class="text-sm text-sand">
          Mensaje
          <textarea
            class="mt-2 min-h-32 w-full rounded-2xl bg-night-soft px-4 py-3 text-paper outline-none placeholder:text-sand"
            name="body"
            required
            placeholder="En qué estás trabajando y por qué me escribes"
          ></textarea>
        </label>
        <button
          class="rounded-full bg-accent-soft px-6 py-3 text-sm font-medium text-ink hover:bg-paper"
          type="submit"
        >
          Abrir email
        </button>
        <p class="text-xs text-sand">
          El formulario abre tu cliente de correo. No guardo nada en un servidor.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#contacto form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const body = String(data.get('body') ?? '').trim();
    const email = 'betorolitos37@gmail.com';
    const subject = encodeURIComponent(`Hola Jesús, te escribe ${name}`);
    const message = encodeURIComponent(body);
    window.location.href = `mailto:${email}?subject=${subject}&body=${message}`;
  });
</script>
