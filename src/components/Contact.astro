---
import { profile, whatsappHref } from '../data/profile';
import AppIcon from './AppIcon.astro';
import type { IconName } from '../data/icons';

const mailHref = `mailto:${profile.email}?subject=${encodeURIComponent('Contacto profesional — portafolio')}`;
const whatsapp = profile.whatsapp ? whatsappHref(profile.whatsapp) : '';

const channels: { href: string; label: string; icon: IconName; external?: boolean }[] = [
  { href: mailHref, label: profile.email, icon: 'mail' },
  { href: profile.github, label: `github.com/${profile.githubUser}`, icon: 'github', external: true },
];

if (profile.linkedin) {
  channels.push({ href: profile.linkedin, label: 'LinkedIn', icon: 'linkedin', external: true });
}
if (whatsapp) {
  channels.push({ href: whatsapp, label: 'WhatsApp', icon: 'whatsapp', external: true });
}
---

<section id="contacto" class="px-4 py-4 md:px-8 md:py-8">
  <div class="tone-night mx-auto max-w-6xl overflow-hidden rounded-[1.5rem] px-5 py-8 md:rounded-[2rem] md:px-12 md:py-16" data-reveal>
    <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end lg:gap-12">
      <div>
        <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-accent-soft md:text-sm">
          <AppIcon name="send" size={14} />
          Contacto
        </p>
        <h2 class="mt-3 font-display text-3xl tracking-tight md:text-5xl">
          Conversemos sobre <em class="italic text-accent-soft">su vacante</em>.
        </h2>
        <p class="mt-4 max-w-md text-sm text-mist">
          {profile.availability}
        </p>
        <div class="mt-10 flex flex-col gap-2">
          {channels.map((channel) => (
            <a
              class="inline-flex w-fit items-center gap-3 rounded-full bg-night-soft px-4 py-2.5 no-underline transition-colors hover:bg-accent"
              href={channel.href}
              target={channel.external ? '_blank' : undefined}
              rel={channel.external ? 'noreferrer' : undefined}
              data-magnetic
            >
              <AppIcon name={channel.icon} size={16} />
              {channel.label}
            </a>
          ))}
        </div>
      </div>

      <form class="flex flex-col gap-4" action={mailHref} method="get">
        <label class="text-sm text-mist">
          Nombre
          <input
            class="mt-2 w-full rounded-2xl bg-night-soft px-4 py-3 text-on-dark outline-none placeholder:text-mist"
            type="text"
            name="name"
            required
            placeholder="Nombre completo"
          />
        </label>
        <label class="text-sm text-mist">
          Mensaje
          <textarea
            class="mt-2 min-h-28 w-full rounded-2xl bg-night-soft px-4 py-3 text-on-dark outline-none placeholder:text-mist md:min-h-36"
            name="body"
            required
            placeholder="Describa la vacante o el motivo de contacto"
          ></textarea>
        </label>
        <button
          class="inline-flex items-center justify-center gap-2 rounded-full bg-accent-soft px-5 py-2.5 text-sm font-medium text-ink hover:bg-accent hover:text-on-dark"
          type="submit"
          data-magnetic
        >
          <AppIcon name="mail" size={16} />
          Enviar correo
        </button>
        <p class="text-xs text-mist">
          El formulario abre el cliente de correo. No se almacena información en un servidor.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#contacto form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const body = String(data.get('body') ?? '').trim();
    const email = 'betorolitos37@gmail.com';
    const subject = encodeURIComponent(`Contacto profesional — ${name}`);
    const message = encodeURIComponent(body);
    window.location.href = `mailto:${email}?subject=${subject}&body=${message}`;
  });
</script>
