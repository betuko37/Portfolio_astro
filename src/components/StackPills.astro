---
import { iconForStack } from '../data/icons';
import AppIcon from './AppIcon.astro';

interface Props {
  items: readonly string[];
  tone?: 'light' | 'dark';
}

const { items, tone = 'light' } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
  {items.map((item) => (
    <li
      class:list={[
        'inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-sm',
        tone === 'dark' ? 'bg-night-soft text-paper' : 'bg-sand text-ink',
      ]}
    >
      <AppIcon name={iconForStack(item)} size={14} />
      {item}
    </li>
  ))}
</ul>
