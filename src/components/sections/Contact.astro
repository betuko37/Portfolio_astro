---
import { profile } from '@data/profile';
import { focusIcons } from '@data/icons';
import AppIcon from '@components/ui/AppIcon.astro';
import FoldText from '@components/effects/fold-text/FoldText.jsx';

const mailHref = `mailto:${profile.email}?subject=${encodeURIComponent('Contacto profesional — portafolio')}`;
const english = profile.languages[0];
---

<section id="contacto" class="px-4 py-6 md:px-8 md:py-10">
  <div class="tone-night relative mx-auto max-w-6xl overflow-hidden rounded-[1.5rem] px-5 py-6 md:rounded-[2rem] md:px-8 md:py-8">
    <span class="pointer-events-none absolute -right-16 -top-20 h-44 w-44 rounded-full bg-accent/30 blur-3xl"></span>
    <span class="pointer-events-none absolute -bottom-24 -left-12 h-40 w-40 rounded-full bg-accent/15 blur-3xl"></span>

    <div class="relative grid gap-6 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-start lg:gap-8">
      <div class="flex flex-col gap-4">
        <div>
          <p class="contact-kicker inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] md:text-sm">
            <AppIcon name="send" size={14} />
            Contacto
          </p>
          <h2 class="mt-2 font-display text-[1.65rem] leading-tight tracking-tight sm:text-3xl md:text-4xl">
            <FoldText
              client:visible
              text="Conversemos sobre su vacante."
              splitBy="word"
              hinge="top"
              trigger="scroll"
              color="currentColor"
              fontSize="inherit"
              fontWeight={700}
            />
          </h2>
          <p class="contact-muted mt-3 max-w-md text-sm leading-relaxed">
            {profile.availability}
          </p>
        </div>

        <div>
          <p class="contact-muted text-xs font-medium uppercase tracking-[0.14em]">En qué encajo bien</p>
          <ul class="mt-2.5 space-y-2">
            {focusIcons.slice(0, 4).map((item) => (
              <li class="contact-muted flex items-start gap-2.5 text-sm leading-snug">
                <span class="mt-0.5 inline-flex shrink-0 text-accent">
                  <AppIcon name={item.icon} size={15} />
                </span>
                {item.label}
              </li>
            ))}
          </ul>
        </div>

        <p class="contact-note text-xs leading-relaxed">
          {profile.location}
          {english ? ` · ${english.name} ${english.level}` : ''}
          · Respuesta habitual en 24–48 h
        </p>
      </div>

      <form class="contact-form flex flex-col gap-3" novalidate>
        <label class="sr-only" for="contact-company">Empresa</label>
        <input
          class="hidden"
          type="text"
          id="contact-company"
          name="company"
          tabindex="-1"
          autocomplete="off"
        />

        <div class="grid gap-3 sm:grid-cols-2">
          <label class="contact-muted text-sm">
            Nombre
            <input
              class="contact-input mt-1.5 w-full rounded-2xl px-4 py-2.5 outline-none"
              type="text"
              name="name"
              required
              autocomplete="name"
              placeholder="Nombre completo"
            />
          </label>

          <label class="contact-muted text-sm">
            Correo
            <input
              class="contact-input mt-1.5 w-full rounded-2xl px-4 py-2.5 outline-none"
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="correo@empresa.com"
            />
          </label>
        </div>

        <label class="contact-muted text-sm">
          Mensaje
          <textarea
            class="contact-input mt-1.5 min-h-24 w-full rounded-2xl px-4 py-2.5 outline-none md:min-h-28"
            name="message"
            required
            placeholder="Rol, stack del equipo o contexto del producto"
          ></textarea>
        </label>

        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-4">
          <button
            class="contact-submit inline-flex items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium disabled:cursor-not-allowed disabled:opacity-60"
            type="submit"
            data-magnetic
          >
            <AppIcon name="mail" size={16} />
            <span class="contact-submit-label">Enviar mensaje</span>
          </button>

          <p class="contact-note text-xs">El formulario llega directo a mi correo.</p>
        </div>

        <p class="contact-feedback hidden text-sm text-accent" data-contact-feedback role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script define:vars={{ mailHref }}>
  const form = document.querySelector('.contact-form');
  const submitBtn = form?.querySelector('.contact-submit');
  const submitLabel = form?.querySelector('.contact-submit-label');
  const feedback = form?.querySelector('[data-contact-feedback]');
  const note = form?.querySelector('.contact-note');

  const setFeedback = (message, tone) => {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.classList.remove('hidden', 'text-accent', 'text-red-300');
    feedback.classList.add(tone === 'ok' ? 'text-accent' : 'text-red-300');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !submitBtn || !submitLabel) return;

    const data = new FormData(form);
    const payload = {
      name: String(data.get('name') ?? '').trim(),
      email: String(data.get('email') ?? '').trim(),
      message: String(data.get('message') ?? '').trim(),
      company: String(data.get('company') ?? '').trim(),
    };

    submitBtn.setAttribute('disabled', 'true');
    submitLabel.textContent = 'Enviando…';
    feedback?.classList.add('hidden');

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const result = await response.json().catch(() => ({}));

      if (response.ok && result.ok) {
        form.reset();
        setFeedback('Mensaje enviado. Le responderé pronto.', 'ok');
        if (note) note.textContent = 'Gracias por escribir.';
        return;
      }

      if (response.status === 503) {
        const subject = encodeURIComponent(`Contacto profesional — ${payload.name}`);
        const body = encodeURIComponent(
          `Nombre: ${payload.name}\nCorreo: ${payload.email}\n\n${payload.message}`,
        );
        window.location.href = `${mailHref.split('?')[0]}?subject=${subject}&body=${body}`;
        return;
      }

      setFeedback(result.error ?? 'No se pudo enviar el mensaje.', 'error');
    } catch {
      setFeedback('Error de red. Verifique su conexión e intente de nuevo.', 'error');
    } finally {
      submitBtn.removeAttribute('disabled');
      submitLabel.textContent = 'Enviar mensaje';
    }
  });
</script>
