---
import { profile } from '@data/profile';
import AppIcon from '@components/ui/AppIcon.astro';
import MexicoFlag from '@components/ui/MexicoFlag.astro';
import ProfilePhoto from '@components/ui/ProfilePhoto.astro';
import TrueFocus from '@components/effects/true-focus/TrueFocus.jsx';
import FoldText from '@components/effects/fold-text/FoldText.jsx';
---

<section class="overflow-visible px-4 pb-8 pt-4 md:px-8 md:pb-14 md:pt-8">
  <div class="mx-auto grid max-w-6xl items-center gap-8 overflow-visible lg:grid-cols-[1.15fr_0.85fr] lg:gap-12" data-hero>
    <div>
      <p
        class="inline-flex max-w-full flex-wrap items-center gap-2 rounded-full bg-sand px-3 py-1.5 text-xs font-medium sm:text-sm"
        data-hero-item
      >
        <MexicoFlag />
        <span>{profile.role}</span>
        <span class="text-muted">·</span>
        <span class="text-muted">{profile.location}</span>
      </p>

      <h1 class="mt-4 max-w-4xl font-display text-[1.5rem] leading-[1.2] sm:text-3xl md:mt-6 md:text-5xl lg:text-6xl">
        <FoldText
          client:load
          text={profile.headlineLead}
          splitBy="word"
          hinge="top"
          trigger="mount"
          duration={0.65}
          stagger={0.045}
          color="currentColor"
          fontSize="inherit"
          fontWeight={700}
        />
        {' '}
        <em class="italic text-accent" data-headline-accent>
          <FoldText
            client:load
            text={profile.headlineAccent}
            splitBy="word"
            hinge="top"
            trigger="mount"
            duration={0.65}
            stagger={0.045}
            color="var(--color-accent)"
            fontSize="inherit"
            fontWeight={700}
          />
        </em>
      </h1>

      <div class="mt-4 md:mt-6">
        <TrueFocus
          client:visible
          sentence="Frontend Backend Mobile"
          blurAmount={4}
          borderColor="var(--color-accent)"
          glowColor="color-mix(in oklab, var(--color-accent) 55%, transparent)"
          animationDuration={0.55}
          pauseBetweenAnimations={1.15}
          className="hero-focus"
        />
      </div>

      <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted md:mt-6 md:text-base lg:text-lg" data-hero-item>
        {profile.summary}
      </p>

      <div class="mt-6 flex flex-wrap gap-2.5 md:mt-8" data-hero-item>
        <a
          href="#proyectos"
          data-magnetic
          class="tone-ink inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-sm font-medium no-underline hover:bg-accent md:px-5"
        >
          Ver portafolio
          <AppIcon name="arrow-right" size={16} />
        </a>
        <a
          href="#contacto"
          data-magnetic
          class="inline-flex items-center gap-2 rounded-full bg-sand px-4 py-2.5 text-sm font-medium text-ink no-underline hover:bg-accent-soft md:px-5"
        >
          Contacto
          <AppIcon name="send" size={16} />
        </a>
      </div>
    </div>

    <div class="relative z-20 flex items-center justify-center overflow-visible py-3 lg:justify-end" data-hero-item>
      <div class="relative z-20 aspect-square w-[min(100%,23rem)] shrink-0 overflow-visible md:w-[28rem]" data-photo-orbit>
        <div class="photo-ring" aria-hidden="true">
          <div class="photo-ring__spin"></div>
        </div>
        <ProfilePhoto class="relative z-[1] w-full" />
      </div>
    </div>
  </div>
</section>
