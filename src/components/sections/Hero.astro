---
import { profile } from '@data/profile';
import AppIcon from '@components/ui/AppIcon.astro';
import MexicoFlag from '@components/ui/MexicoFlag.astro';
import ProfilePhoto from '@components/ui/ProfilePhoto.astro';
import TrueFocus from '@components/effects/true-focus/TrueFocus.jsx';
---

<section id="inicio" class="scroll-mt-28 overflow-x-clip px-4 pb-6 pt-3 md:scroll-mt-32 md:px-8 md:pb-14 md:pt-8">
  <div
    class="mx-auto grid max-w-6xl items-center gap-4 md:gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12"
    data-hero
  >
    <p
      class="order-1 mx-auto inline-flex max-w-full flex-wrap items-center justify-center gap-2 rounded-full bg-sand px-3 py-1.5 text-xs font-medium sm:text-sm lg:col-start-1 lg:mx-0"
      data-hero-item
    >
      <MexicoFlag />
      <span>{profile.role}</span>
      <span class="text-muted">·</span>
      <span class="text-muted">{profile.location}</span>
    </p>

    <div
      class="order-2 flex justify-center lg:col-start-2 lg:row-start-1 lg:row-span-3 lg:justify-end lg:self-center"
      data-hero-item
    >
      <div
        class="photo-orbit relative aspect-square w-[9.5rem] shrink-0 sm:w-[13rem] md:w-[20rem] lg:w-[28rem]"
        data-photo-orbit
      >
        <div class="photo-ring" aria-hidden="true">
          <div class="photo-ring__spin"></div>
        </div>
        <ProfilePhoto priority class="relative z-[1] w-full" />
      </div>
    </div>

    <div class="order-3 text-center lg:col-start-1 lg:row-start-2 lg:mt-4 lg:text-left">
      <h1 class="mx-auto max-w-4xl font-display text-[1.55rem] leading-[1.2] sm:text-3xl md:text-5xl lg:mx-0 lg:text-6xl">
        {profile.headlineLead}{' '}
        <em class="italic text-accent">{profile.headlineAccent}</em>
      </h1>

      <div class="mt-4 flex justify-center md:mt-6 lg:justify-start">
        <TrueFocus
          client:visible
          sentence="Frontend Backend Mobile"
          blurAmount={4}
          borderColor="var(--color-accent)"
          glowColor="color-mix(in oklab, var(--color-accent) 55%, transparent)"
          animationDuration={0.55}
          pauseBetweenAnimations={1.15}
          className="hero-focus"
        />
      </div>

      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted md:mt-6 md:text-base lg:mx-0 lg:text-lg" data-hero-item>
        {profile.summary}
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-2.5 md:mt-8 lg:justify-start" data-hero-item>
        <a
          href="#proyectos"
          data-magnetic
          class="tone-ink inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-sm font-medium no-underline hover:bg-accent md:px-5"
        >
          Ver portafolio
          <AppIcon name="arrow-right" size={16} />
        </a>
        <a
          href="#contacto"
          data-magnetic
          class="inline-flex items-center gap-2 rounded-full bg-sand px-4 py-2.5 text-sm font-medium text-ink no-underline hover:bg-accent-soft md:px-5"
        >
          Contacto
          <AppIcon name="send" size={16} />
        </a>
        <button
          type="button"
          data-cv-open
          data-magnetic
          class="inline-flex items-center gap-2 rounded-full bg-sand px-4 py-2.5 text-sm font-medium text-ink hover:bg-accent-soft md:px-5"
        >
          Ver CV
          <AppIcon name="file-text" size={16} />
        </button>
      </div>
    </div>
  </div>
</section>
