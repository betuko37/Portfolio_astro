---
import { getShowcase, showcaseSections } from '@data/showcase';
import { profile } from '@data/profile';
import { projectSpotlights, getSpotlightProjectSlugs } from '@data/spotlights';
import ShowcaseRail from '@components/showcase/ShowcaseRail.astro';
import ShowcaseBreak from '@components/showcase/ShowcaseBreak.astro';
import SpotlightCard from '@components/showcase/SpotlightCard.astro';
import StackMarquee from '@components/ui/StackMarquee.astro';
import AppIcon from '@components/ui/AppIcon.astro';

const live = showcaseSections.find((section) => section.id === 'live')!;
const github = showcaseSections.find((section) => section.id === 'github')!;
const practices = showcaseSections.find((section) => section.id === 'cv')!;
const spotlightSlugs = getSpotlightProjectSlugs();
const liveItems = getShowcase(live.id).filter(
  (item) => !spotlightSlugs.has(item.id.replace(/^(case|lab)-/, '')),
);
---

<section id="proyectos" class="px-4 py-10 md:px-8 md:py-20">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 md:gap-16">
    <ShowcaseBreak
      kicker="Proyectos"
      icon="folder-kanban"
      title="Casos reales, no solo demos."
      copy="ERP agrícola, empaque, fiscal México e integraciones de hardware en producción. JornalPro, Agroeasy, HikCentral, cotizaciones CFDI y campo offline-first."
    >
      <a
        slot="action"
        href="#live"
        class="btn-accent inline-flex items-center gap-1.5 rounded-full px-3.5 py-2 text-xs font-medium no-underline md:text-sm"
      >
        Ver todos
        <AppIcon name="arrow-right" size={14} />
      </a>
      <div class="grid grid-cols-2 gap-2.5 md:grid-cols-3 md:gap-3">
        {projectSpotlights.map((item) => (
          <SpotlightCard item={item} />
        ))}
      </div>
    </ShowcaseBreak>

    <ShowcaseRail
      id={live.id}
      title={live.title}
      kicker={live.kicker}
      icon={live.icon}
      items={liveItems}
    />

    <ShowcaseBreak
      kicker="Stack"
      icon="cpu"
      title="Tecnologías utilizadas en producción."
    >
      <StackMarquee items={profile.stack} />
    </ShowcaseBreak>

    <ShowcaseRail
      id={github.id}
      title={github.title}
      kicker={github.kicker}
      icon={github.icon}
      items={getShowcase(github.id)}
    />

    <ShowcaseBreak
      kicker="Formación"
      icon="briefcase"
      title="Ingeniería en Software y prácticas."
      copy="Universidad Estatal de Sonora (2021–2025) y Cecytes Hermosillo V (2017–2020). Inglés B1."
    >
      <a
        slot="action"
        href="/sobre"
        class="inline-flex items-center gap-1.5 rounded-full bg-ink px-3.5 py-2 text-xs font-medium text-paper no-underline md:text-sm"
      >
        Ver formación
        <AppIcon name="arrow-right" size={14} />
      </a>
      <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center sm:gap-3">
        {profile.education.map((item) => (
          <article class="flex items-center gap-3 rounded-[1.2rem] bg-paper px-4 py-3 text-ink">
            <span
              class:list={[
                'inline-flex h-12 w-20 items-center justify-center overflow-hidden rounded-xl px-2',
                item.logoTone === 'night' ? 'bg-black' : 'bg-sand',
              ]}
            >
              <img src={item.logo} alt={item.school} class="max-h-10 max-w-full object-contain" />
            </span>
            <div>
              <p class="text-sm font-medium">{item.program}</p>
              <p class="text-xs text-muted">{item.school}</p>
            </div>
          </article>
        ))}
      </div>
    </ShowcaseBreak>

    <ShowcaseRail
      id={practices.id}
      title={practices.title}
      kicker={practices.kicker}
      icon={practices.icon}
      items={getShowcase(practices.id)}
    />
  </div>
</section>
