---
import { getLiveLink, type Project } from '@data/projects';
import { projectIcons } from '@data/icons';
import { getProjectLogo, getProjectCover, projectLogoUsesLightBg } from '@data/media';
import AppIcon from '@components/ui/AppIcon.astro';

interface Props {
  project: Project;
  large?: boolean;
}

const { project, large = false } = Astro.props;
const live = getLiveLink(project);
const logo = getProjectLogo(project.slug);
const logoLightBg = projectLogoUsesLightBg(project.slug);
const cover = getProjectCover(project.slug);
const phoneCover = project.slug.includes('mobile');
---

<a
  href={`/proyectos/${project.slug}`}
  data-card
  class:list={[
    'group flex h-full flex-col justify-between overflow-hidden rounded-[2rem] no-underline',
    `tone-${project.accent}`,
    large ? 'min-h-[240px] md:min-h-[360px]' : 'min-h-[200px] md:min-h-[240px]',
  ]}
>
  <div class="flex flex-1 flex-col justify-between p-4 md:p-7">
    <div>
      <div class="mb-4 flex items-start justify-between gap-3">
        <span class:list={['inline-flex h-11 w-11 items-center justify-center overflow-hidden rounded-2xl p-2 md:h-14 md:w-14', logoLightBg ? 'bg-white' : 'bg-paper/15']}>
          {logo ? (
            <img src={logo} alt="" class="h-full w-full object-contain" />
          ) : (
            <AppIcon name={projectIcons[project.slug]} size={large ? 32 : 26} />
          )}
        </span>
        {live && (
          <span class="live-badge px-2.5 py-1 text-[11px] tracking-wide">
            <span class="live-dot"></span>
            En vivo
          </span>
        )}
      </div>
      <p class="text-xs font-medium uppercase tracking-[0.16em] opacity-70">{project.kicker}</p>
      <h3 class="mt-2 font-display text-xl tracking-tight md:text-3xl">{project.title}</h3>
      <p class="mt-2 max-w-xl text-sm leading-relaxed opacity-85 md:text-base">{project.tagline}</p>
    </div>
    <p class="mt-5 inline-flex items-center gap-2 text-sm font-medium opacity-75 md:mt-8">
      Ver estudio de caso
      <span class="transition-transform duration-300 group-hover:translate-x-1">
        <AppIcon name="arrow-right" size={16} />
      </span>
    </p>
  </div>

  {cover && (
    <div class:list={['overflow-hidden', large ? 'h-32 md:h-52' : 'h-24 md:h-36']}>
      <img
        src={cover}
        alt=""
        class:list={[
          'h-full w-full transition-transform duration-700 ease-out group-hover:scale-105',
          phoneCover ? 'object-contain bg-black/20' : 'object-cover object-top',
        ]}
      />
    </div>
  )}
</a>
