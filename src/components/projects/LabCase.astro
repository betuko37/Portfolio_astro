---
import type { Lab } from '@data/labs';
import { getRelatedLabs, labLinks } from '@data/labs';
import { fromLab } from '@data/showcase';
import AppIcon from '@components/ui/AppIcon.astro';
import BackLink from '@components/layout/BackLink.astro';
import StackPills from '@components/ui/StackPills.astro';
import ShowcaseCard from '@components/showcase/ShowcaseCard.astro';
import FoldText from '@components/effects/fold-text/FoldText.jsx';

interface Props {
  lab: Lab;
}

const { lab } = Astro.props;
const links = labLinks(lab);
const related = getRelatedLabs(lab.slug);
const facts = [
  lab.live ? 'Demostración en línea' : null,
  lab.githubRepos?.length ? 'Repositorios en GitHub' : lab.github ? 'Repositorio en GitHub' : null,
  lab.fromCv ? 'Práctica profesional' : null,
].filter((item): item is string => Boolean(item));
---

<article>
  <header class="px-4 pt-3 md:px-8">
    <div class="mx-auto mb-3 max-w-7xl">
      <BackLink href="/#proyectos" />
    </div>
    <div class="tone-night relative mx-auto max-w-7xl overflow-hidden rounded-[1.5rem] px-5 py-8 md:rounded-[2rem] md:px-10 md:py-12" data-hero>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-black via-black/90 to-[#2a1048]/60"></div>
      <span class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-accent/20 blur-3xl"></span>
      <div class="relative">
        <div class="flex flex-wrap items-center gap-2" data-hero-item>
          <span class="rounded-full bg-paper/10 px-3 py-1 text-[11px] font-medium text-mist">{lab.kicker}</span>
          <span class="rounded-full bg-paper/10 px-3 py-1 text-[11px] font-medium tabular-nums text-mist">{lab.year.replace(' — ', '–')}</span>
        </div>
        <h1 class="mt-5 max-w-3xl font-display text-2xl tracking-tight sm:text-3xl md:text-6xl">
          <FoldText
            client:load
            text={lab.title}
            splitBy="word"
            hinge="top"
            trigger="mount"
            color="currentColor"
            fontSize="inherit"
            fontWeight={700}
          />
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-mist md:text-lg" data-hero-item>
          {lab.tagline}
        </p>
        {facts.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2" data-hero-item>
            {facts.map((fact) => (
              <span class="rounded-full bg-paper/10 px-3 py-1 text-xs text-mist">{fact}</span>
            ))}
          </div>
        )}
        {links.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3" data-hero-item>
            {links.map((link) => (
              <a
                class="inline-flex items-center gap-2 rounded-full bg-paper px-4 py-2.5 text-sm font-medium text-ink no-underline hover:bg-accent-soft"
                href={link.href}
                target="_blank"
                rel="noreferrer"
                data-magnetic
              >
                {link.label}
                <AppIcon name="arrow-up-right" size={14} />
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-12" data-reveal>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-6 lg:grid-cols-12">
      <article class="rounded-[1.4rem] bg-sand p-5 md:col-span-4 lg:col-span-7">
        <p class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-accent">
          <AppIcon name="sparkles" size={14} />
          Descripción
        </p>
        <p class="mt-3 text-sm leading-relaxed">{lab.summary ?? lab.tagline}</p>
        {lab.highlights && lab.highlights.length > 0 && (
          <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
            {lab.highlights.map((item) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        )}
      </article>
      <article class="rounded-[1.4rem] bg-sand p-5 md:col-span-2 lg:col-span-5">
        <p class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-accent">
          <AppIcon name="cpu" size={14} />
          Stack
        </p>
        <div class="mt-3">
          <StackPills items={lab.stack} />
        </div>
        {lab.modules && lab.modules.length > 0 && (
          <div class="mt-6">
            <p class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-accent">
              <AppIcon name="layers" size={14} />
              Módulos
            </p>
            <ul class="mt-3 space-y-1.5 text-sm text-muted">
              {lab.modules.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}
      </article>
      {related.map((item) => (
        <div class="md:col-span-3 lg:col-span-4">
          <ShowcaseCard item={fromLab(item)} />
        </div>
      ))}
    </div>
  </div>
</article>
