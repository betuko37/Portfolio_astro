---
import type { ArchLayer } from '@components/projects/ArchLayers.astro';
import AppIcon from '@components/ui/AppIcon.astro';
import ArchDiagram from '@components/projects/ArchDiagram.astro';
import ArchLayers from '@components/projects/ArchLayers.astro';

interface Props {
  layers?: ArchLayer[];
  chart?: string;
  archifySrc?: string;
  diagramHints?: Record<string, DiagramHint>;
}

interface DiagramHint {
  title: string;
  subtitle?: string;
  kind?: string;
  layer?: string;
  body: string;
}

const { layers, chart, archifySrc, diagramHints } = Astro.props;
const useArchify = Boolean(archifySrc);
const hasChart = Boolean(chart);
const hasLayers = Boolean(layers?.length);
const embedSrc = archifySrc ? `${archifySrc}?embed=1` : undefined;
const hintsJson = diagramHints ? JSON.stringify(diagramHints) : '';
---

<section
  class="arch-view text-center"
  data-arch-view
  data-arch-mode={useArchify ? 'archify' : 'legacy'}
  data-arch-src={archifySrc}
  data-arch-hints={hintsJson || undefined}
>
  <div class="arch-view-head">
    <p class="deck-label">
      <AppIcon name="share-2" size={14} />
      Arquitectura
    </p>
    <button
      type="button"
      class="arch-view-expand inline-flex items-center gap-1.5 rounded-full bg-sand px-3 py-1.5 text-[10px] font-medium text-ink hover:bg-accent-soft md:px-3.5 md:py-2 md:text-sm"
      data-arch-expand
    >
      <AppIcon name="maximize-2" size={14} />
      Pantalla completa
    </button>
  </div>

  <div class="arch-view-stage" data-arch-stage>
    {useArchify ? (
      <div class="arch-embed-shell" data-arch-embed-shell>
        <div class="arch-embed-wrap">
          <iframe
            class="arch-embed"
            src={embedSrc}
            title="Diagrama de arquitectura"
            loading="lazy"
            data-arch-iframe
          />
        </div>
        <p class="arch-embed-hint">
          <AppIcon name="info" size={13} />
          Haz clic en un componente para ver detalle
        </p>
        <div class="arch-popover" data-arch-popover hidden>
          <div
            class="arch-popover-panel"
            role="dialog"
            aria-modal="false"
            aria-labelledby="arch-popover-title"
            data-arch-popover-panel
          >
            <button type="button" class="arch-popover-close" data-arch-popover-close aria-label="Cerrar detalle">
              <AppIcon name="x" size={16} />
            </button>
            <div class="arch-popover-meta">
              <span class="arch-popover-kind" data-arch-popover-kind hidden></span>
              <span class="arch-popover-layer" data-arch-popover-layer hidden></span>
            </div>
            <h3 class="arch-popover-title" id="arch-popover-title" data-arch-popover-title></h3>
            <p class="arch-popover-sub" data-arch-popover-sub hidden></p>
            <p class="arch-popover-body" data-arch-popover-body></p>
            <div class="arch-popover-rels" data-arch-popover-rels hidden>
              <p class="arch-popover-rels-label">Conexiones</p>
              <div class="arch-popover-rel-list" data-arch-popover-rel-list></div>
            </div>
          </div>
        </div>
      </div>
    ) : hasChart ? (
      <ArchDiagram chart={chart!} />
    ) : hasLayers ? (
      <ArchLayers layers={layers!} />
    ) : null}
  </div>

  <dialog class="arch-dialog" data-arch-dialog aria-label="Arquitectura en pantalla completa">
    <div class="arch-dialog-panel">
      <div class="arch-dialog-toolbar">
        <p class="arch-dialog-title">Arquitectura</p>
        <div class="arch-zoom-controls" data-arch-controls>
          <button type="button" class="arch-zoom-btn" data-arch-zoom-out aria-label="Alejar">
            <AppIcon name="minus" size={16} />
          </button>
          <span class="arch-zoom-value" data-arch-zoom-value>100%</span>
          <button type="button" class="arch-zoom-btn" data-arch-zoom-in aria-label="Acercar">
            <AppIcon name="plus" size={16} />
          </button>
          <button type="button" class="arch-zoom-btn" data-arch-zoom-reset aria-label="Restablecer vista">
            <AppIcon name="rotate-ccw" size={16} />
          </button>
        </div>
        <button type="button" class="arch-dialog-close" data-arch-close aria-label="Cerrar pantalla completa">
          <AppIcon name="x" size={18} />
        </button>
      </div>
      <div class="arch-dialog-body" data-arch-dialog-body>
        <div class="arch-dialog-shell" data-arch-shell>
          <div class="arch-viewport" data-arch-viewport>
            <div class="arch-canvas" data-arch-canvas></div>
          </div>
          <iframe
            class="arch-dialog-iframe hidden"
            title="Diagrama de arquitectura en pantalla completa"
            data-arch-dialog-iframe
          />
          <p class="arch-viewport-hint" data-arch-hint>Arrastra para mover · Usa la rueda o los controles para zoom</p>
        </div>
      </div>
    </div>
  </dialog>
</section>

<style>
  .arch-view-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }

  .arch-view-stage {
    display: flex;
    justify-content: center;
  }

  .arch-embed-shell {
    position: relative;
    width: min(100%, 72rem);
    margin: 0 auto;
  }

  .arch-embed-wrap {
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: min(82vh, 720px);
  }

  .arch-embed {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 1rem;
    background: var(--color-paper);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-mist) 35%, transparent);
  }

  .arch-embed-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.75rem 0 0;
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  .arch-view {
    position: relative;
  }

  .arch-popover {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 120;
    width: min(22rem, calc(100vw - 1.5rem));
    pointer-events: none;
  }

  .arch-popover[hidden] {
    display: none;
  }

  .arch-popover-panel {
    pointer-events: auto;
    max-height: min(42vh, 16rem);
    overflow: auto;
    padding: 0.85rem 0.95rem 0.95rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in oklab, var(--color-accent) 28%, var(--color-mist));
    background: color-mix(in oklab, var(--color-paper) 92%, transparent);
    box-shadow:
      0 18px 40px color-mix(in oklab, var(--color-night) 18%, transparent),
      inset 0 1px 0 color-mix(in oklab, var(--color-paper) 70%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    text-align: left;
    animation: arch-popover-in 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes arch-popover-in {
    from {
      opacity: 0;
      transform: translateY(0.45rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .arch-popover-close {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-sand);
    color: var(--color-ink);
    cursor: pointer;
  }

  .arch-popover-close:hover {
    background: var(--color-accent-soft);
  }

  .arch-popover-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.45rem;
    padding-right: 2rem;
  }

  .arch-popover-kind,
  .arch-popover-layer {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .arch-popover-kind {
    background: color-mix(in oklab, var(--color-accent) 16%, var(--color-sand));
    color: var(--color-accent);
  }

  .arch-popover-layer {
    background: var(--color-sand);
    color: var(--color-muted);
  }

  .arch-popover-kind[hidden],
  .arch-popover-layer[hidden],
  .arch-popover-sub[hidden],
  .arch-popover-rels[hidden] {
    display: none;
  }

  .arch-popover-title {
    margin: 0 0 0.25rem;
    padding-right: 1.75rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .arch-popover-sub {
    margin: 0 0 0.45rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .arch-popover-body {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-ink) 88%, var(--color-muted));
  }

  .arch-popover-rels {
    margin-top: 0.75rem;
    padding-top: 0.7rem;
    border-top: 1px solid color-mix(in oklab, var(--color-mist) 50%, transparent);
  }

  .arch-popover-rels-label {
    margin: 0 0 0.45rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .arch-popover-rel-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .arch-popover-rel {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    max-width: 100%;
    border: 0;
    border-radius: 999px;
    padding: 0.28rem 0.65rem;
    background: var(--color-sand);
    color: var(--color-ink);
    font-size: 0.68rem;
    cursor: pointer;
    transition: background-color 0.18s ease;
  }

  .arch-popover-rel:hover {
    background: var(--color-accent-soft);
  }

  .arch-popover-rel small {
    color: var(--color-muted);
    font-size: 0.62rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-popover-panel {
      animation: none;
    }
  }

  .arch-dialog {
    width: min(100vw, 100%);
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    z-index: 100;
  }

  .arch-dialog::backdrop {
    background: color-mix(in oklab, var(--color-night) 72%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition:
      opacity 0.38s ease,
      overlay 0.38s ease allow-discrete,
      display 0.38s ease allow-discrete;
  }

  .arch-dialog[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .arch-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  .arch-dialog-panel {
    display: flex;
    flex-direction: column;
    width: 100vw;
    height: 100dvh;
    background: var(--color-paper);
    color: var(--color-ink);
    opacity: 0;
    transform: scale(0.94) translateY(1rem);
    transition:
      opacity 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .arch-dialog[open] .arch-dialog-panel {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  @starting-style {
    .arch-dialog[open] .arch-dialog-panel {
      opacity: 0;
      transform: scale(0.94) translateY(1rem);
    }
  }

  .arch-dialog.is-closing::backdrop {
    opacity: 0;
  }

  .arch-dialog.is-closing .arch-dialog-panel {
    opacity: 0;
    transform: scale(0.97) translateY(0.5rem);
    transition-duration: 0.24s;
    transition-timing-function: ease-in;
  }

  .arch-dialog-shell {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    width: 100%;
  }

  .arch-zoom-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem;
    border-radius: 999px;
    background: var(--color-sand);
  }

  .arch-zoom-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .arch-zoom-btn:hover {
    background: var(--color-accent-soft);
  }

  .arch-zoom-value {
    min-width: 3rem;
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: center;
    color: var(--color-muted);
  }

  .arch-viewport {
    position: relative;
    flex: 1 1 auto;
    min-height: 12rem;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .arch-viewport.is-dragging {
    cursor: grabbing;
  }

  .arch-canvas {
    display: block;
    width: max-content;
    max-width: none;
    transform-origin: 0 0;
    will-change: transform;
  }

  .arch-canvas :global(.mer-wrap) {
    width: max-content !important;
    max-width: none !important;
    overflow: visible;
  }

  .arch-canvas :global(svg) {
    display: block;
    max-width: none !important;
  }

  .arch-canvas :global(.arch.is-large),
  .arch-canvas :global(.arch) {
    width: max-content;
    max-width: none;
  }

  .arch-dialog-panel .arch-popover {
    z-index: 30;
  }

  .arch-dialog-iframe {
    flex: 1 1 auto;
    width: 100%;
    min-height: 12rem;
    border: 0;
    background: var(--color-paper);
  }

  .arch-dialog-iframe.hidden {
    display: none;
  }

  .arch-viewport-hint {
    margin: 0;
    padding: 0.65rem 1rem 0.85rem;
    text-align: center;
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  .arch-dialog[data-archify-open] .arch-zoom-controls,
  .arch-dialog[data-archify-open] .arch-viewport-hint {
    display: none;
  }

  .arch-dialog[data-archify-open] .arch-viewport {
    display: none;
  }

  .arch-dialog[data-archify-open] .arch-dialog-iframe.hidden {
    display: block;
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .arch-dialog::backdrop,
    .arch-dialog-panel {
      transition: none !important;
      animation: none !important;
    }

    .arch-dialog-panel {
      transform: none !important;
    }

    .arch-dialog[open]::backdrop,
    .arch-dialog[open] .arch-dialog-panel {
      opacity: 1;
    }
  }

  .arch-dialog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1rem 0.85rem 1.25rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-mist) 45%, transparent);
  }

  .arch-dialog-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .arch-dialog-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    background: var(--color-sand);
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .arch-dialog-close:hover {
    background: var(--color-accent-soft);
  }

  .arch-dialog-body {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0.75rem 0;
  }

  @media (max-width: 639px) {
    .arch-dialog-toolbar {
      flex-wrap: wrap;
    }

    .arch-zoom-controls {
      order: 3;
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  type DiagramHint = {
    title: string;
    subtitle?: string;
    kind?: string;
    layer?: string;
    body: string;
  };

  type ArchifyRelationship = {
    id: string;
    label: string;
    direction: 'in' | 'out';
    edgeLabel?: string;
  };

  type ArchifyNodePayload = {
    id: string;
    label: string;
    sublabel?: string;
    kind?: string;
    tag?: string;
    context?: string;
    relationships?: ArchifyRelationship[];
  };

  type ArchifyAnchor = {
    x: number;
    y: number;
  };

  type PopoverPlacement = {
    anchor?: ArchifyAnchor;
    frame: HTMLIFrameElement | null;
  };

  const POPOVER_GAP = 14;
  const POPOVER_MARGIN = 12;

  function placeArchPopover(popover: HTMLElement, placement: PopoverPlacement) {
    const { frame } = placement;
    if (!frame) return;

    const frameRect = frame.getBoundingClientRect();
    let anchorX = frameRect.left + frameRect.width / 2;
    let anchorY = frameRect.top + frameRect.height / 2;
    if (placement.anchor) {
      anchorX = frameRect.left + placement.anchor.x;
      anchorY = frameRect.top + placement.anchor.y;
    }

    popover.style.transform = 'none';
    popover.style.bottom = 'auto';

    const margin = POPOVER_MARGIN;
    const gap = POPOVER_GAP;
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const popW = popover.offsetWidth;
    const popH = popover.offsetHeight;
    const stackBelow = vw < 640 || popW >= vw - margin * 2 - 40;

    let left: number;
    let top: number;

    if (stackBelow) {
      left = Math.max(margin, Math.min(anchorX - popW / 2, vw - popW - margin));
      top = anchorY + gap;
      if (top + popH > vh - margin) {
        top = anchorY - gap - popH;
      }
    } else {
      const spaceRight = vw - margin - (anchorX + gap);
      const spaceLeft = anchorX - gap - margin;
      if (spaceRight >= popW || spaceRight >= spaceLeft) {
        left = anchorX + gap;
      } else {
        left = anchorX - gap - popW;
      }
      left = Math.max(margin, Math.min(left, vw - popW - margin));
      top = anchorY - popH / 2;
    }

    top = Math.max(margin, Math.min(top, vh - popH - margin));

    const coversClick =
      anchorX >= left && anchorX <= left + popW && anchorY >= top && anchorY <= top + popH;
    if (coversClick) {
      top = anchorY + gap;
      if (top + popH > vh - margin) {
        top = anchorY - gap - popH;
      }
      top = Math.max(margin, Math.min(top, vh - popH - margin));
    }

    popover.style.left = `${Math.round(left)}px`;
    popover.style.top = `${Math.round(top)}px`;
  }

  const KIND_LABELS: Record<string, string> = {
    frontend: 'Frontend',
    backend: 'Backend',
    database: 'Datos',
    cloud: 'Nube',
    security: 'Seguridad',
    messagebus: 'Mensajería',
    external: 'Externo',
  };

  function parseHints(raw: string | undefined) {
    if (!raw) return {} as Record<string, DiagramHint>;
    try {
      return JSON.parse(raw) as Record<string, DiagramHint>;
    } catch {
      return {};
    }
  }

  function postToFrame(frame: HTMLIFrameElement | null, payload: Record<string, unknown>) {
    if (!frame?.contentWindow) return;
    frame.contentWindow.postMessage({ source: 'portfolio-archify-host', ...payload }, window.location.origin);
  }

  function initArchifyPopover(
    root: HTMLElement,
    getActiveFrame: () => HTMLIFrameElement | null,
    getPopoverHost: () => HTMLElement,
  ) {
    const popover = root.querySelector<HTMLElement>('[data-arch-popover]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-arch-popover-close]');
    const titleEl = root.querySelector<HTMLElement>('[data-arch-popover-title]');
    const subEl = root.querySelector<HTMLElement>('[data-arch-popover-sub]');
    const bodyEl = root.querySelector<HTMLElement>('[data-arch-popover-body]');
    const kindEl = root.querySelector<HTMLElement>('[data-arch-popover-kind]');
    const layerEl = root.querySelector<HTMLElement>('[data-arch-popover-layer]');
    const relWrap = root.querySelector<HTMLElement>('[data-arch-popover-rels]');
    const relList = root.querySelector<HTMLElement>('[data-arch-popover-rel-list]');
    if (!popover || !closeBtn || !titleEl || !subEl || !bodyEl || !kindEl || !layerEl || !relWrap || !relList) {
      return { open: () => {}, close: () => {} };
    }

    const mountPopover = () => {
      const host = getPopoverHost();
      if (popover.parentElement !== host) host.appendChild(popover);
    };

    mountPopover();

    const hints = parseHints(root.dataset.archHints);
    let lastPlacement: PopoverPlacement | null = null;

    const reposition = () => {
      if (popover.hidden || !lastPlacement) return;
      placeArchPopover(popover, lastPlacement);
    };

    window.addEventListener('scroll', reposition, { passive: true });
    window.addEventListener('resize', reposition);

    const setMeta = (element: HTMLElement, value: string | undefined) => {
      const clean = value?.trim();
      element.textContent = clean ?? '';
      element.hidden = !clean;
    };

    const close = (notifyFrame = true) => {
      popover.hidden = true;
      lastPlacement = null;
      if (notifyFrame) postToFrame(getActiveFrame(), { type: 'clear' });
    };

    const open = (node: ArchifyNodePayload, placement: PopoverPlacement) => {
      const hint = hints[node.id];
      const title = hint?.title || node.label;
      const subtitle = hint?.subtitle || node.sublabel || node.context || '';
      const body =
        hint?.body ||
        node.context ||
        node.sublabel ||
        'Componente del flujo de arquitectura. Explora las conexiones relacionadas abajo.';

      titleEl.textContent = title;
      setMeta(subEl, subtitle);
      bodyEl.textContent = body;
      setMeta(kindEl, KIND_LABELS[hint?.kind || node.kind || ''] || hint?.kind || node.kind);
      setMeta(layerEl, hint?.layer || node.context);

      relList.textContent = '';
      const relationships = node.relationships ?? [];
      if (relationships.length) {
        relWrap.hidden = false;
        relationships.slice(0, 6).forEach((rel) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'arch-popover-rel';
          btn.dataset.relId = rel.id;
          const arrow = rel.direction === 'out' ? '→' : '←';
          const edge = rel.edgeLabel ? `<small>${rel.edgeLabel}</small>` : '';
          btn.innerHTML = `${arrow} ${rel.label} ${edge}`;
          btn.addEventListener('click', () => {
            postToFrame(getActiveFrame(), { type: 'set-focus', id: rel.id });
          });
          relList.appendChild(btn);
        });
      } else {
        relWrap.hidden = true;
      }

      popover.hidden = false;
      lastPlacement = placement;
      mountPopover();

      const measureAndPlace = () => {
        if (popover.offsetHeight < 1) {
          requestAnimationFrame(measureAndPlace);
          return;
        }
        placeArchPopover(popover, placement);
      };
      measureAndPlace();
    };

    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !popover.hidden) close();
    });

    return { open, close, mount: mountPopover };
  }

  function archifyEmbedSrc(pathname: string, options?: { fullscreen?: boolean }) {
    const theme = document.documentElement.dataset.theme;
    const params = new URLSearchParams();
    params.set('embed', '1');
    if (options?.fullscreen) params.set('fullscreen', '1');
    if (theme === 'light' || theme === 'dark') {
      params.set('theme', theme);
    }
    return `${pathname}?${params.toString()}`;
  }

  function initArchifyViewer(root: HTMLElement) {
    const dialog = root.querySelector<HTMLDialogElement>('[data-arch-dialog]');
    const openBtn = root.querySelector<HTMLButtonElement>('[data-arch-expand]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-arch-close]');
    const inlineFrame = root.querySelector<HTMLIFrameElement>('[data-arch-iframe]');
    const dialogFrame = root.querySelector<HTMLIFrameElement>('[data-arch-dialog-iframe]');
    const baseSrc = root.dataset.archSrc;
    if (!dialog || !openBtn || !closeBtn || !inlineFrame || !dialogFrame || !baseSrc) return;

    const dialogPanel = dialog.querySelector<HTMLElement>('.arch-dialog-panel');
    if (!dialogPanel) return;

    let scrollY = 0;
    const CLOSE_MS = 240;
    const getActiveFrame = () => (dialog.open ? dialogFrame : inlineFrame);
    const getPopoverHost = () => (dialog.open ? dialogPanel : document.body);
    const popover = initArchifyPopover(root, getActiveFrame, getPopoverHost);

    const syncTheme = () => {
      inlineFrame.src = archifyEmbedSrc(baseSrc);
    };

    syncTheme();
    const themeObserver = new MutationObserver(syncTheme);
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    window.addEventListener('message', (event) => {
      if (event.origin !== window.location.origin) return;
      if (event.source !== inlineFrame.contentWindow && event.source !== dialogFrame.contentWindow) return;
      const data = event.data as {
        source?: string;
        type?: string;
        node?: ArchifyNodePayload;
        anchor?: ArchifyAnchor;
      };
      if (data?.source !== 'portfolio-archify') return;
      if (data.type === 'clear') {
        popover.close(false);
        return;
      }
      if (data.type === 'node-focus' && data.node) {
        const frame = event.source === dialogFrame.contentWindow ? dialogFrame : inlineFrame;
        popover.open(data.node, { anchor: data.anchor, frame });
      }
    });

    const unlockScroll = () => {
      document.body.classList.remove('arch-dialog-open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      window.scrollTo(0, scrollY);
    };

    const open = () => {
      scrollY = window.scrollY;
      dialog.classList.remove('is-closing');
      dialog.setAttribute('data-archify-open', '');
      root.setAttribute('data-arch-dialog-open', '');
      popover.mount();
      dialogFrame.src = archifyEmbedSrc(baseSrc, { fullscreen: true });
      dialog.showModal();
      document.body.classList.add('arch-dialog-open');
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
    };

    const finishClose = () => {
      dialog.classList.remove('is-closing');
      dialog.removeAttribute('data-archify-open');
      root.removeAttribute('data-arch-dialog-open');
      dialogFrame.removeAttribute('src');
      popover.close();
      popover.mount();
      if (!dialog.open) {
        unlockScroll();
        return;
      }
      dialog.close();
      unlockScroll();
    };

    const close = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        finishClose();
        return;
      }
      dialog.classList.add('is-closing');
      window.setTimeout(finishClose, CLOSE_MS);
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
  }

  function initLegacyArchViewer(root: HTMLElement) {
    const dialog = root.querySelector<HTMLDialogElement>('[data-arch-dialog]');
    const openBtn = root.querySelector<HTMLButtonElement>('[data-arch-expand]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-arch-close]');
    const viewport = root.querySelector<HTMLElement>('[data-arch-viewport]');
    const canvas = root.querySelector<HTMLElement>('[data-arch-canvas]');
    const zoomInBtn = root.querySelector<HTMLButtonElement>('[data-arch-zoom-in]');
    const zoomOutBtn = root.querySelector<HTMLButtonElement>('[data-arch-zoom-out]');
    const zoomResetBtn = root.querySelector<HTMLButtonElement>('[data-arch-zoom-reset]');
    const zoomValue = root.querySelector<HTMLElement>('[data-arch-zoom-value]');
    const stage = root.querySelector<HTMLElement>('[data-arch-stage]');
    if (!dialog || !openBtn || !closeBtn || !viewport || !canvas || !zoomInBtn || !zoomOutBtn || !zoomResetBtn || !zoomValue) {
      return;
    }

    let scrollY = 0;
    let scale = 1;
    let panX = 0;
    let panY = 0;
    let dragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragPanX = 0;
    let dragPanY = 0;
    let movedNode: Element | null = null;

    const MIN_SCALE = 0.35;
    const MAX_SCALE = 3.5;
    const SCALE_STEP = 0.15;

    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

    const applyTransform = () => {
      canvas.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
      zoomValue.textContent = `${Math.round(scale * 100)}%`;
    };

    const centerView = () => {
      const width = viewport.clientWidth;
      const height = viewport.clientHeight;
      const contentWidth = canvas.scrollWidth || canvas.offsetWidth;
      const contentHeight = canvas.scrollHeight || canvas.offsetHeight;
      panX = (width - contentWidth * scale) / 2;
      panY = (height - contentHeight * scale) / 2;
    };

    const resetView = () => {
      scale = 1;
      centerView();
      applyTransform();
    };

    const zoomAt = (clientX: number, clientY: number, nextScale: number) => {
      const rect = viewport.getBoundingClientRect();
      const px = clientX - rect.left;
      const py = clientY - rect.top;
      const contentX = (px - panX) / scale;
      const contentY = (py - panY) / scale;
      scale = clamp(nextScale, MIN_SCALE, MAX_SCALE);
      panX = px - contentX * scale;
      panY = py - contentY * scale;
      applyTransform();
    };

    const zoomBy = (delta: number) => {
      const rect = viewport.getBoundingClientRect();
      zoomAt(rect.left + rect.width / 2, rect.top + rect.height / 2, scale + delta);
    };

    const waitForLayout = () =>
      new Promise<void>((resolve) => {
        requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
      });

    const waitForMermaid = async () => {
      for (let attempt = 0; attempt < 30; attempt += 1) {
        const mermaid = (window as Window & { mermaid?: { run: (opts?: { nodes?: Element[] }) => Promise<void> } }).mermaid;
        if (mermaid) return mermaid;
        await new Promise((resolve) => window.setTimeout(resolve, 50));
      }
      return null;
    };

    const ensureStageRendered = async () => {
      if (!stage) return;
      const mermaid = await waitForMermaid();
      if (!mermaid) return;

      const pending = Array.from(stage.querySelectorAll<HTMLElement>('.mermaid:not([data-processed])'));
      if (pending.length) {
        await mermaid.run({ nodes: pending });
      }
    };

    const mountStageContent = () => {
      if (!stage) return;
      const content = stage.firstElementChild;
      if (!content || canvas.contains(content)) return;
      movedNode = content;
      canvas.replaceChildren(content);
    };

    const fixCanvasDimensions = () => {
      const svg = canvas.querySelector('svg');
      const wrap = canvas.querySelector('.mer-wrap');
      if (!(svg instanceof SVGSVGElement)) return;

      const viewBox = svg.viewBox.baseVal;
      const bbox = svg.getBBox();
      const width = viewBox.width || bbox.width;
      const height = viewBox.height || bbox.height;
      if (width <= 0 || height <= 0) return;

      if (wrap instanceof HTMLElement) {
        wrap.classList.remove('w-full', 'max-w-3xl', 'max-w-6xl');
        wrap.style.setProperty('width', `${width}px`, 'important');
        wrap.style.setProperty('height', `${height}px`, 'important');
        wrap.style.setProperty('max-width', 'none', 'important');
        wrap.style.setProperty('overflow', 'visible', 'important');
      }

      svg.setAttribute('width', String(width));
      svg.setAttribute('height', String(height));
      svg.style.setProperty('width', `${width}px`, 'important');
      svg.style.setProperty('height', `${height}px`, 'important');
      svg.style.setProperty('max-width', 'none', 'important');

      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
    };

    const restoreStageContent = () => {
      if (!stage || !movedNode) return;
      const wrap = movedNode.querySelector('.mer-wrap');
      const svg = movedNode.querySelector('svg');
      if (wrap instanceof HTMLElement) {
        wrap.classList.add('w-full', 'max-w-3xl');
        wrap.style.removeProperty('width');
        wrap.style.removeProperty('height');
        wrap.style.removeProperty('max-width');
        wrap.style.removeProperty('overflow');
      }
      if (svg instanceof SVGSVGElement) {
        svg.removeAttribute('width');
        svg.removeAttribute('height');
        svg.style.removeProperty('width');
        svg.style.removeProperty('height');
        svg.style.removeProperty('max-width');
      }
      canvas.style.removeProperty('width');
      canvas.style.removeProperty('height');
      stage.appendChild(movedNode);
      movedNode = null;
    };

    const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CLOSE_MS = 240;

    const unlockScroll = () => {
      document.body.classList.remove('arch-dialog-open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      window.scrollTo(0, scrollY);
    };

    const open = async () => {
      scrollY = window.scrollY;
      dialog.classList.remove('is-closing');
      await ensureStageRendered();
      dialog.showModal();
      document.body.classList.add('arch-dialog-open');
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      mountStageContent();
      await waitForLayout();
      fixCanvasDimensions();
      resetView();
    };

    const finishClose = () => {
      dialog.classList.remove('is-closing');
      restoreStageContent();
      if (!dialog.open) {
        unlockScroll();
        return;
      }
      dialog.close();
      resetView();
      unlockScroll();
    };

    const close = () => {
      if (!dialog.open || dialog.classList.contains('is-closing')) return;
      if (reduceMotion()) {
        finishClose();
        return;
      }
      dialog.classList.add('is-closing');
      window.setTimeout(finishClose, CLOSE_MS);
    };

    openBtn.addEventListener('click', () => {
      void open();
    });

    closeBtn.addEventListener('click', close);

    zoomInBtn.addEventListener('click', () => zoomBy(SCALE_STEP));
    zoomOutBtn.addEventListener('click', () => zoomBy(-SCALE_STEP));
    zoomResetBtn.addEventListener('click', resetView);

    viewport.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault();
        const delta = event.deltaY > 0 ? -SCALE_STEP : SCALE_STEP;
        zoomAt(event.clientX, event.clientY, scale + delta);
      },
      { passive: false },
    );

    viewport.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      dragging = true;
      dragStartX = event.clientX;
      dragStartY = event.clientY;
      dragPanX = panX;
      dragPanY = panY;
      viewport.setPointerCapture(event.pointerId);
      viewport.classList.add('is-dragging');
    });

    viewport.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      panX = dragPanX + (event.clientX - dragStartX);
      panY = dragPanY + (event.clientY - dragStartY);
      applyTransform();
    });

    const stopDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      viewport.classList.remove('is-dragging');
      if (viewport.hasPointerCapture(event.pointerId)) {
        viewport.releasePointerCapture(event.pointerId);
      }
    };

    viewport.addEventListener('pointerup', stopDrag);
    viewport.addEventListener('pointercancel', stopDrag);

    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
  }

  document.querySelectorAll<HTMLElement>('[data-arch-view]').forEach((root) => {
    if (root.dataset.archMode === 'archify') {
      initArchifyViewer(root);
      return;
    }
    initLegacyArchViewer(root);
  });
</script>
