---
import { getLiveLink, type Project } from '@data/projects';
import { projectIcons } from '@data/icons';
import { getProjectLogo, getProjectCover, projectLogoUsesLightBg } from '@data/media';
import AppIcon from '@components/ui/AppIcon.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const count = projects.length;
---

{count > 0 && (
  <section class="project-related related-section" data-reveal>
    <div class="related-shell">
      <header class="related-head">
        <p class="deck-label">
          <AppIcon name="folder-kanban" size={14} />
          Proyectos relacionados
          <span class="related-count">{count}</span>
        </p>
        <p class="related-lead">Otros casos del mismo ecosistema.</p>
      </header>

      <div class="related-grid" data-count={count}>
        {projects.map((item) => {
          const live = getLiveLink(item);
          const logo = getProjectLogo(item.slug);
          const logoLightBg = projectLogoUsesLightBg(item.slug);
          const cover = getProjectCover(item.slug);
          const phoneCover = item.slug.includes('mobile');

          return (
            <a
              href={`/proyectos/${item.slug}`}
              data-card
              class:list={['related-card', `tone-${item.accent}`]}
            >
              <div class="related-card-body">
                <div class="related-card-top">
                  <span class:list={['related-logo', logoLightBg && 'is-light']}>
                    {logo ? (
                      <img src={logo} alt="" />
                    ) : (
                      <AppIcon name={projectIcons[item.slug]} size={22} />
                    )}
                  </span>
                  {live && (
                    <span class="live-badge related-live">
                      <span class="live-dot"></span>
                      En vivo
                    </span>
                  )}
                </div>

                <p class="related-kicker">{item.kicker}</p>
                <h3 class="related-title">{item.title}</h3>
                <p class="related-tagline">{item.tagline}</p>

                <p class="related-cta">
                  Ver estudio
                  <AppIcon name="arrow-right" size={14} />
                </p>
              </div>

              <div class:list={['related-media', !cover && 'is-empty', phoneCover && 'is-phone']}>
                {cover ? (
                  <img src={cover} alt="" />
                ) : (
                  <span class="related-media-glow" aria-hidden="true"></span>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .related-section {
    padding: 0.5rem 1rem 2.5rem;
  }

  .related-shell {
    max-width: 80rem;
    margin: 0 auto;
  }

  .related-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1.1rem;
  }

  .related-count {
    margin-left: 0.2rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    padding: 0.08rem 0.45rem;
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--color-accent);
  }

  .related-lead {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .related-grid {
    display: grid;
    grid-auto-flow: dense;
    gap: 0.85rem;
    grid-template-columns: minmax(0, 1fr);
  }

  .related-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    border-radius: 1.35rem;
    text-decoration: none;
    box-shadow: 0 10px 28px color-mix(in srgb, var(--color-night) 8%, transparent);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }

  .related-card-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 1.05rem 1.1rem 0.85rem;
  }

  .related-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.65rem;
    margin-bottom: 0.85rem;
  }

  .related-logo {
    display: inline-flex;
    height: 2.6rem;
    width: 2.6rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-paper) 16%, transparent);
    padding: 0.35rem;
  }

  .related-logo.is-light {
    background: #fff;
  }

  .related-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .related-live {
    padding: 0.2rem 0.55rem;
    font-size: 0.62rem;
  }

  .related-kicker {
    margin: 0;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.68;
  }

  .related-title {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .related-tagline {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin: 0.4rem 0 0;
    min-height: 2.4em;
    font-size: 0.8rem;
    line-height: 1.45;
    opacity: 0.82;
  }

  .related-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: auto 0 0;
    padding-top: 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.78;
  }

  .related-cta :global(svg) {
    transition: transform 0.3s ease;
  }

  .related-media {
    height: 6.25rem;
    overflow: hidden;
  }

  .related-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.7s ease;
  }

  .related-media.is-phone img {
    object-fit: contain;
    background: color-mix(in srgb, #000 18%, transparent);
  }

  .related-media.is-empty {
    position: relative;
    background: color-mix(in srgb, currentColor 8%, transparent);
  }

  .related-media-glow {
    position: absolute;
    inset: auto -20% -40% 30%;
    height: 7rem;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 18%, transparent);
    filter: blur(28px);
  }

  @media (hover: hover) and (pointer: fine) {
    .related-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 36px color-mix(in srgb, var(--color-night) 14%, transparent);
    }

    .related-card:hover .related-cta :global(svg) {
      transform: translateX(4px);
    }

    .related-card:hover .related-media img {
      transform: scale(1.06);
    }
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .related-grid[data-count='1'] {
      grid-template-columns: minmax(0, 1fr);
    }

    .related-title {
      font-size: 1.35rem;
    }

    .related-media {
      height: 7.25rem;
    }
  }

  @media (min-width: 1024px) {
    .related-section {
      padding: 1rem 2rem 4rem;
    }

    .related-head {
      margin-bottom: 1.35rem;
    }

    .related-card-body {
      padding: 1.25rem 1.3rem 1rem;
    }

    .related-grid[data-count='1'] {
      grid-template-columns: minmax(0, 46rem);
    }

    .related-grid[data-count='1'] .related-card {
      flex-direction: row;
      min-height: 15rem;
    }

    .related-grid[data-count='1'] .related-card-body {
      flex: 1 1 58%;
      padding: 1.6rem 1.7rem;
    }

    .related-grid[data-count='1'] .related-media {
      flex: 1 1 42%;
      height: auto;
    }

    .related-grid[data-count='2'],
    .related-grid[data-count='4'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .related-grid[data-count='3'],
    .related-grid[data-count='6'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .related-grid[data-count='5'] {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .related-grid[data-count='5'] > :nth-child(-n + 2) {
      grid-column: span 3;
    }

    .related-grid[data-count='5'] > :nth-child(n + 3) {
      grid-column: span 2;
    }
  }

  @media (min-width: 1280px) {
    .related-title {
      font-size: 1.5rem;
    }

    .related-tagline {
      font-size: 0.88rem;
    }

    .related-media {
      height: 8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-card,
    .related-cta :global(svg),
    .related-media img {
      transition: none;
    }
  }
</style>
