---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import StackPills from '../components/StackPills.astro';
import AppIcon from '../components/AppIcon.astro';
import BackLink from '../components/BackLink.astro';
import { profile } from '../data/profile';
import { focusIcons } from '../data/icons';
import { profilePhoto } from '../data/media';
---

<Layout
  title={`Sobre mí — ${profile.name}`}
  description={profile.summary}
>
  <section class="px-4 py-6 md:px-8 md:py-16">
    <div class="mx-auto mb-5 max-w-6xl">
      <BackLink href="/" />
    </div>
    <div class="mx-auto grid max-w-6xl items-end gap-6 md:grid-cols-[0.8fr_1.2fr] md:gap-12" data-hero>
      <div class="relative overflow-hidden rounded-[1.5rem] bg-sand md:rounded-[2rem]" data-hero-item>
        <img
          src={profilePhoto}
          alt={profile.name}
          class="aspect-[4/5] max-h-64 w-full object-cover object-top md:max-h-none"
        />
      </div>
      <div>
        <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-accent md:text-sm" data-hero-item>
          <AppIcon name="user-round" size={14} />
          Perfil
        </p>
        <h1 class="mt-3 font-display text-3xl tracking-tight md:text-6xl" data-hero-item>
          {profile.fullName}
        </h1>
        <p class="mt-3 text-sm leading-relaxed text-muted md:text-lg" data-hero-item>{profile.headline}</p>
        <p class="mt-6 inline-flex items-center gap-2 text-sm text-muted" data-hero-item>
          <span class="live-dot text-accent"></span>
          {profile.location}. {profile.availability}
        </p>
      </div>
    </div>

    <div class="mx-auto mt-8 max-w-3xl space-y-4 text-sm leading-relaxed md:mt-14 md:text-base" data-reveal>
      {profile.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="mx-auto mt-10 grid max-w-3xl gap-3 sm:grid-cols-2" data-reveal>
      {profile.education.map((item) => (
        <article class="overflow-hidden rounded-[1.4rem] bg-sand">
          <div
            class:list={[
              'flex h-28 items-center justify-center px-5 py-4 md:h-32',
              item.logoTone === 'night' ? 'bg-black' : 'bg-paper',
            ]}
          >
            <img
              src={item.logo}
              alt={item.school}
              class="max-h-full max-w-full object-contain"
            />
          </div>
          <div class="p-5">
            <p class="text-xs font-medium uppercase tracking-[0.16em] text-accent">{item.years}</p>
            <h2 class="mt-2 font-display text-lg tracking-tight">{item.program}</h2>
            <p class="mt-1 text-sm text-muted">{item.school}</p>
          </div>
        </article>
      ))}
      {profile.languages.map((item) => (
        <article class="rounded-[1.4rem] bg-sand p-5 sm:col-span-2">
          <p class="text-xs font-medium uppercase tracking-[0.16em] text-accent">Idiomas</p>
          <p class="mt-2 text-sm">{item.name} · {item.level}</p>
        </article>
      ))}
    </div>

    <div class="mx-auto mt-14 max-w-3xl" data-reveal>
      <p class="mb-4 inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-muted">
        <AppIcon name="sparkles" size={14} />
        Enfoque
      </p>
      <div class="flex flex-wrap gap-2">
        {focusIcons.map((item) => (
          <span class="inline-flex items-center gap-2 rounded-full bg-sand px-3.5 py-1.5 text-sm">
            <AppIcon name={item.icon} size={14} />
            {item.label}
          </span>
        ))}
      </div>
    </div>

    <div class="mx-auto mt-12 max-w-3xl" data-reveal>
      <p class="mb-4 inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-muted">
        <AppIcon name="cpu" size={14} />
        Stack
      </p>
      <StackPills items={profile.stack} />
      <p class="mb-3 mt-8 text-sm font-medium uppercase tracking-[0.18em] text-muted">También</p>
      <StackPills items={profile.alsoStack} />
    </div>
  </section>
  <Contact />
</Layout>
