---
import Layout from '../layouts/Layout.astro';
import Contact from '../components/Contact.astro';
import StackPills from '../components/StackPills.astro';
import AppIcon from '../components/AppIcon.astro';
import BackLink from '../components/BackLink.astro';
import ShowcaseBreak from '../components/ShowcaseBreak.astro';
import MexicoFlag from '../components/MexicoFlag.astro';
import { profile } from '../data/profile';
import { focusIcons } from '../data/icons';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import FoldText from '../components/FoldText.jsx';
---

<Layout
  title={`Sobre mí — ${profile.name}`}
  description={profile.summary}
>
  <section class="px-4 py-6 md:px-8 md:py-16">
    <div class="mx-auto mb-5 max-w-6xl">
      <BackLink href="/" />
    </div>

    <div class="mx-auto grid max-w-6xl overflow-hidden rounded-[1.5rem] bg-sand md:grid-cols-[0.85fr_1.15fr] md:rounded-[2rem]" data-hero>
      <div class="flex items-center justify-center bg-sand px-8 py-10 md:px-10 md:py-14" data-hero-item>
        <ProfilePhoto class="w-full max-w-[18rem] md:max-w-[23rem]" />
      </div>
      <div class="flex flex-col justify-center px-5 py-8 md:px-10 md:py-14">
        <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-accent md:text-sm" data-hero-item>
          <AppIcon name="user-round" size={14} />
          Sobre mí
        </p>
        <h1 class="mt-3 font-display text-3xl tracking-tight md:text-5xl lg:text-6xl">
          <FoldText
            client:load
            text={profile.fullName}
            splitBy="word"
            hinge="top"
            trigger="mount"
            color="currentColor"
            fontSize="inherit"
            fontWeight={700}
          />
        </h1>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted md:text-lg" data-hero-item>
          {profile.headlineLead}{' '}
          <em class="italic text-accent">{profile.headlineAccent}</em>
        </p>
        <div class="mt-6 flex flex-wrap gap-2" data-hero-item>
          <span class="inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-xs text-ink md:text-sm">
            <MexicoFlag />
            {profile.location}
          </span>
          <span class="inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-xs text-ink md:text-sm">
            <AppIcon name="briefcase" size={14} />
            {profile.role}
          </span>
          <span class="inline-flex items-center gap-2 rounded-full bg-paper px-3 py-1.5 text-xs text-ink md:text-sm">
            <span class="live-dot text-accent"></span>
            Disponible
          </span>
        </div>
        <a
          href="/#contacto"
          class="mt-8 inline-flex w-fit items-center gap-1.5 rounded-full bg-ink px-4 py-2.5 text-sm font-medium text-paper no-underline"
          data-hero-item
        >
          Contacto
          <AppIcon name="arrow-right" size={14} />
        </a>
      </div>
    </div>

    <div class="mx-auto mt-8 max-w-6xl md:mt-12">
      <ShowcaseBreak
        kicker="Perfil"
        icon="user-round"
        title="Productos complejos, no solo CRUDs."
        copy={profile.about.join(' ')}
      />
    </div>

    <div class="mx-auto mt-8 max-w-6xl md:mt-12" data-reveal>
      <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-accent md:text-sm">
        <AppIcon name="briefcase" size={14} />
        Formación
      </p>
      <h2 class="mt-2 font-display text-2xl tracking-tight md:text-4xl">
        <FoldText
          client:visible
          text="Estudios e idioma."
          splitBy="word"
          hinge="top"
          trigger="scroll"
          color="currentColor"
          fontSize="inherit"
          fontWeight={700}
        />
      </h2>
      <div class="mt-6 grid gap-3 md:grid-cols-3">
        {profile.education.map((item) => (
          <article class="overflow-hidden rounded-[1.4rem] bg-sand">
            <div
              class:list={[
                'flex h-32 items-center justify-center px-5 py-4',
                item.logoTone === 'night' ? 'bg-black' : 'bg-paper',
              ]}
            >
              <img
                src={item.logo}
                alt={item.school}
                class="max-h-full max-w-full object-contain"
              />
            </div>
            <div class="px-4 py-3.5">
              <p class="text-[11px] font-medium tabular-nums text-accent">{item.years}</p>
              <h3 class="mt-1 font-display text-base tracking-tight md:text-lg">{item.program}</h3>
              <p class="mt-0.5 text-sm text-muted">{item.school}</p>
            </div>
          </article>
        ))}
        {profile.languages.map((item) => (
          <article class="flex flex-col justify-between rounded-[1.4rem] bg-sand p-5">
            <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.16em] text-accent">
              <AppIcon name="globe" size={14} />
              Idiomas
            </p>
            <div class="mt-8">
              <h3 class="font-display text-lg tracking-tight">{item.name}</h3>
              <p class="mt-1 text-sm text-muted">Nivel {item.level}</p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="mx-auto mt-8 max-w-6xl md:mt-12">
      <ShowcaseBreak kicker="Enfoque" icon="sparkles" title="En qué puedo contribuir.">
        <div class="flex flex-wrap gap-2">
          {focusIcons.map((item) => (
            <span class="inline-flex items-center gap-2 rounded-full bg-paper px-3.5 py-1.5 text-sm">
              <AppIcon name={item.icon} size={14} />
              {item.label}
            </span>
          ))}
        </div>
      </ShowcaseBreak>
    </div>

    <div class="mx-auto mt-8 max-w-6xl md:mt-12">
      <ShowcaseBreak kicker="Stack" icon="cpu" title="Tecnologías de trabajo.">
        <StackPills items={profile.stack} />
        <p class="mb-3 mt-8 text-xs font-medium uppercase tracking-[0.18em] text-muted">Otras tecnologías</p>
        <StackPills items={profile.alsoStack} />
      </ShowcaseBreak>
    </div>
  </section>
  <Contact />
</Layout>
