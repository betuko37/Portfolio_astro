---
import Layout from '../../layouts/Layout.astro';
import StackPills from '../../components/StackPills.astro';
import ModuleList from '../../components/ModuleList.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import {
  getProject,
  getRelatedProjects,
  projects,
} from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProject(slug!);

if (!project) {
  throw new Error(`Proyecto no encontrado: ${slug}`);
}

const related = getRelatedProjects(project.slug);
---

<Layout title={`${project.title} — Jesús Zavala`} description={project.summary}>
  <article>
    <header class="px-5 pt-8 md:px-8">
      <div class="mx-auto max-w-6xl rounded-3xl bg-ink px-6 py-12 text-paper md:px-12 md:py-20">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent-soft">
          {project.kicker} · {project.year}
        </p>
        <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight md:text-6xl">
          {project.title}
        </h1>
        <p class="mt-5 max-w-2xl text-xl leading-relaxed text-sand">{project.tagline}</p>
        <p class="mt-6 text-sm text-sand">{project.role}</p>
        {project.links.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3">
            {project.links.map((link) => (
              <a
                class="rounded-full bg-paper px-4 py-2 text-sm font-medium text-ink no-underline hover:bg-accent-soft"
                href={link.href}
                target="_blank"
                rel="noreferrer"
              >
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    <section class="px-5 py-16 md:px-8 md:py-20">
      <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[1fr_1fr]">
        <div>
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">El problema</p>
          <p class="mt-4 text-lg leading-relaxed">{project.problem}</p>
        </div>
        <div>
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">Qué es</p>
          <p class="mt-4 text-lg leading-relaxed">{project.summary}</p>
        </div>
      </div>
    </section>

    <section class="px-5 pb-16 md:px-8">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">Stack</p>
        <div class="mt-5">
          <StackPills items={project.stack} />
        </div>
      </div>
    </section>

    <section class="px-5 pb-16 md:px-8">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">Arquitectura</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight">Cómo se conecta</h2>
        <div class="mt-8">
          <ArchDiagram chart={project.architecture} />
        </div>
      </div>
    </section>

    <section class="px-5 pb-16 md:px-8">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">Módulos</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight">Qué hay dentro</h2>
        <div class="mt-8">
          <ModuleList modules={project.modules} />
        </div>
      </div>
    </section>

    <section class="px-5 pb-16 md:px-8">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">Cómo funciona</p>
        <ol class="mt-8 grid gap-4 md:grid-cols-2">
          {project.howItWorks.map((step, index) => (
            <li class="rounded-2xl bg-sand p-6">
              <span class="text-sm font-medium text-accent">{String(index + 1).padStart(2, '0')}</span>
              <p class="mt-2 leading-relaxed">{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="px-5 py-8 md:px-8 md:py-12">
      <div class="mx-auto max-w-6xl">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">Por qué importa</p>
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {project.highlights.map((item) => (
            <li class="rounded-2xl bg-accent-soft p-6 leading-relaxed">{item}</li>
          ))}
        </ul>
      </div>
    </section>

    {related.length > 0 && (
      <section class="px-5 pb-20 md:px-8">
        <div class="mx-auto max-w-6xl">
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-muted">Relacionados</p>
          <div class="mt-6 grid gap-4 md:grid-cols-3">
            {related.map((item) => (
              <ProjectCard project={item} />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout>

<script is:inline type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
  mermaid.initialize({
    startOnLoad: true,
    theme: 'neutral',
    securityLevel: 'loose',
    fontFamily: 'DM Sans, sans-serif',
  });
</script>
