---
import Layout from '@layouts/Layout.astro';
import LabCase from '@components/projects/LabCase.astro';
import {
  getLiveLink,
  getProject,
  projects,
} from '@data/projects';
import { getLab, labs } from '@data/labs';
import { projectIcons } from '@data/icons';
import { getProjectCover, getProjectGallery, getProjectLogo, projectLogoUsesLightBg } from '@data/media';
import AppIcon from '@components/ui/AppIcon.astro';
import BackLink from '@components/layout/BackLink.astro';
import Carousel from '@components/ui/Carousel.astro';
import CaseStudyDeck from '@components/projects/CaseStudyDeck.astro';
import FoldText from '@components/effects/fold-text/FoldText.jsx';

export function getStaticPaths() {
  return [
    ...projects.map((project) => ({ params: { slug: project.slug } })),
    ...labs.map((lab) => ({ params: { slug: lab.slug } })),
  ];
}

const { slug } = Astro.params;
const project = getProject(slug!);
const lab = getLab(slug!);

if (!project && !lab) {
  throw new Error(`Proyecto no encontrado: ${slug}`);
}

const gallery = project ? getProjectGallery(project.slug) : undefined;
const logo = project ? getProjectLogo(project.slug) : undefined;
const logoLightBg = project ? projectLogoUsesLightBg(project.slug) : false;
const cover = project ? getProjectCover(project.slug) : undefined;
const live = project ? getLiveLink(project) : undefined;
const title = project?.title ?? lab!.title;
const description = project?.summary ?? lab!.tagline;
---

<Layout title={`${title} — Jesús Zavala`} description={description}>
  {lab && <LabCase lab={lab} />}
  {project && (
  <article>
    <header class="px-4 pt-3 md:px-8">
      <div class="mx-auto mb-3 max-w-7xl">
        <BackLink href="/#proyectos" />
      </div>
      <div class="project-hero tone-night relative mx-auto max-w-7xl overflow-hidden rounded-[1.25rem] px-4 py-6 md:rounded-[2rem] md:px-10 md:py-12" data-hero>
        {cover && (
          <img
            src={cover}
            alt=""
            class="pointer-events-none absolute inset-0 h-full w-full object-cover object-top opacity-20"
          />
        )}
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-black via-black/85 to-[#2a1048]/70"></div>
        <span class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-accent/25 blur-3xl"></span>
        <span class="pointer-events-none absolute -bottom-20 -left-10 h-40 w-40 rounded-full bg-accent/15 blur-3xl md:hidden"></span>
        <div class="relative grid items-center gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:gap-12">
          <div>
            <div class="project-hero-top flex items-start gap-3 lg:hidden" data-hero-item>
              <span class:list={['inline-flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-xl p-2', logoLightBg ? 'bg-white' : 'bg-paper/10 backdrop-blur-sm']}>
                {logo ? (
                  <img src={logo} alt="" class="h-full w-full object-contain" />
                ) : (
                  <AppIcon name={projectIcons[project.slug]} size={24} />
                )}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="project-hero-chip">{project.kicker}</span>
                  <span class="project-hero-chip tabular-nums">{project.year.replace(' — ', '–')}</span>
                  {live && (
                    <span class="live-badge px-2.5 py-0.5 text-[10px]">
                      <span class="live-dot"></span>
                      En vivo
                    </span>
                  )}
                </div>
                <p class="project-hero-role-mobile mt-2 inline-flex items-center gap-1.5 text-[10px]">
                  <AppIcon name="briefcase" size={12} />
                  {project.role}
                </p>
              </div>
            </div>

            <div class="hidden flex-wrap items-center gap-2 lg:flex" data-hero-item>
              <span class="project-hero-chip">{project.kicker}</span>
              <span class="project-hero-chip tabular-nums">{project.year.replace(' — ', '–')}</span>
              {live && (
                <span class="live-badge px-3 py-1 text-[11px]">
                  <span class="live-dot"></span>
                  En vivo
                </span>
              )}
            </div>
            <h1 class="project-hero-title mt-3 max-w-3xl font-display text-[1.35rem] leading-[1.12] tracking-tight sm:text-3xl md:mt-5 md:text-6xl md:leading-none">
              <FoldText
                client:load
                text={project.title}
                splitBy="word"
                hinge="top"
                trigger="mount"
                color="currentColor"
                fontSize="inherit"
                fontWeight={700}
              />
            </h1>
            <p class="project-hero-tagline mt-3 max-w-xl text-[11px] leading-relaxed sm:text-base md:mt-4 md:text-lg" data-hero-item>{project.tagline}</p>
            <p class="project-hero-role mt-3 hidden max-w-xl items-center gap-2 rounded-full bg-white/10 px-3 py-1.5 text-xs md:mt-4 md:inline-flex md:text-sm" data-hero-item>
              <AppIcon name="briefcase" size={14} />
              {project.role}
            </p>
            {project.links.length > 0 ? (
              <div class="project-hero-links mt-5 grid grid-cols-2 gap-2 md:mt-8 md:flex md:flex-wrap md:gap-2.5" data-hero-item>
                {project.links.map((link) => (
                  <a
                    class="project-hero-link inline-flex min-w-0 items-center justify-center gap-1.5 rounded-full px-3 py-2 text-[10px] font-medium no-underline md:justify-start md:px-4 md:py-2.5 md:text-sm"
                    href={link.href}
                    target="_blank"
                    rel="noreferrer"
                    data-magnetic
                  >
                    {link.label}
                    <AppIcon name="arrow-up-right" size={13} class="shrink-0" />
                  </a>
                ))}
              </div>
            ) : project.slug === 'jornalpro-mobile' && !gallery ? (
              <p class="mt-5 text-[11px] text-mist md:mt-8 md:text-sm">Aplicación Android (APK). Registro fotográfico pendiente.</p>
            ) : null}
          </div>
          <div class="hidden lg:flex lg:justify-end" data-hero-icon>
            <div class:list={['relative flex h-56 w-56 items-center justify-center overflow-hidden rounded-[2rem] p-8 backdrop-blur-md', logoLightBg ? 'bg-white' : 'bg-paper/10']}>
              {logo ? (
                <img src={logo} alt="" class="max-h-full max-w-full object-contain" />
              ) : (
                <AppIcon name={projectIcons[project.slug]} size={72} />
              )}
            </div>
          </div>
        </div>
      </div>
    </header>

    {gallery && (
      <Carousel
        images={gallery.images}
        variant={gallery.variant}
        title={gallery.variant === 'phone' ? 'Aplicación móvil' : 'Capturas de pantalla'}
      />
    )}

    <div class="mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-12" data-reveal>
      <CaseStudyDeck project={project} />
    </div>
  </article>
  )}
</Layout>

{project && (
<script>
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    securityLevel: 'loose',
    fontFamily: 'Poppins, sans-serif',
    themeVariables: {
      fontFamily: 'Poppins, sans-serif',
      fontSize: '14px',
      primaryColor: '#ebe6f4',
      primaryTextColor: '#0a0a0a',
      primaryBorderColor: '#7c3aed',
      lineColor: '#7c3aed',
      secondaryColor: '#f7f6fb',
      tertiaryColor: '#ede9fe',
      clusterBkg: 'transparent',
      clusterBorder: '#c9c2d8',
    },
    flowchart: {
      curve: 'basis',
      padding: 12,
      nodeSpacing: 28,
      rankSpacing: 40,
      htmlLabels: true,
    },
  });

  window.mermaid = mermaid;
  void mermaid.run();
</script>
)}
