---
import Layout from '@layouts/Layout.astro';
import LabCase from '@components/projects/LabCase.astro';
import {
  getLiveLink,
  getProject,
  getRelatedProjects,
  projects,
} from '@data/projects';
import { getLab, labs } from '@data/labs';
import { projectIcons } from '@data/icons';
import { getProjectCover, getProjectGallery, getProjectLogo, projectLogoUsesLightBg } from '@data/media';
import AppIcon from '@components/ui/AppIcon.astro';
import BackLink from '@components/layout/BackLink.astro';
import CircularGallery from '@components/ui/CircularGallery.astro';
import CaseStudyDeck from '@components/projects/CaseStudyDeck.astro';
import ProjectRelated from '@components/projects/ProjectRelated.astro';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return [
    ...projects.map((project) => ({ params: { slug: project.slug } })),
    ...labs.map((lab) => ({ params: { slug: lab.slug } })),
  ];
}

const { slug } = Astro.params;
const project = getProject(slug!);
const lab = getLab(slug!);

if (!project && !lab) {
  throw new Error(`Proyecto no encontrado: ${slug}`);
}

const gallery = project ? getProjectGallery(project.slug) : undefined;
const logo = project ? getProjectLogo(project.slug) : undefined;
const logoLightBg = project ? projectLogoUsesLightBg(project.slug) : false;
const cover = project ? getProjectCover(project.slug) : undefined;
const live = project ? getLiveLink(project) : undefined;
const related = project ? getRelatedProjects(project.slug) : [];
const title = project?.title ?? lab!.title;
const description = project?.summary ?? lab!.tagline;
const needsMermaid = Boolean(
  project?.architecture &&
    !fs.existsSync(path.join(process.cwd(), 'public', 'diagrams', `${project.slug}.html`)),
);
---

<Layout title={`${title} — Jesús Zavala`} description={description}>
  {lab && <LabCase lab={lab} />}
  {project && (
  <article class="project-page">
    <header class="px-4 pt-3 md:px-8">
      <div class="mx-auto mb-3 max-w-7xl">
        <BackLink href="/#proyectos" />
      </div>
      <div
        class="project-hero tone-night relative mx-auto max-w-7xl overflow-hidden rounded-[1.25rem] px-5 py-7 md:rounded-[2rem] md:px-10 md:py-12"
        data-accent={project.accent}
        data-hero
      >
        {cover && (
          <img
            src={cover}
            alt=""
            class="pointer-events-none absolute inset-0 h-full w-full object-cover object-top opacity-[0.22]"
            loading="eager"
            decoding="async"
          />
        )}
        <div class="project-hero-gradient pointer-events-none absolute inset-0" aria-hidden="true"></div>
        <span class="project-hero-glow project-hero-glow-a pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full blur-3xl" aria-hidden="true"></span>
        <span class="project-hero-glow project-hero-glow-b pointer-events-none absolute -bottom-20 -left-10 h-40 w-40 rounded-full blur-3xl md:hidden" aria-hidden="true"></span>
        <div class="relative grid items-center gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12">
          <div class="min-w-0">
            <div class="project-hero-top flex items-start gap-3 lg:hidden">
              <span class:list={['inline-flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-2xl p-2', logoLightBg ? 'bg-white' : 'bg-white/10 backdrop-blur-sm']}>
                {logo ? (
                  <img src={logo} alt="" class="h-full w-full object-contain" />
                ) : (
                  <AppIcon name={projectIcons[project.slug]} size={26} />
                )}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="project-hero-chip">{project.kicker}</span>
                  <span class="project-hero-chip tabular-nums">{project.year.replace(' — ', '–')}</span>
                  {live && (
                    <span class="live-badge px-2.5 py-0.5 text-[10px]">
                      <span class="live-dot"></span>
                      En vivo
                    </span>
                  )}
                </div>
                <p class="project-hero-role-mobile mt-2 inline-flex items-center gap-1.5 text-xs">
                  <AppIcon name="briefcase" size={13} />
                  {project.role}
                </p>
              </div>
            </div>

            <div class="hidden flex-wrap items-center gap-2 lg:flex">
              <span class="project-hero-chip">{project.kicker}</span>
              <span class="project-hero-chip tabular-nums">{project.year.replace(' — ', '–')}</span>
              {live && (
                <span class="live-badge px-3 py-1 text-[11px]">
                  <span class="live-dot"></span>
                  En vivo
                </span>
              )}
            </div>
            <h1 class="project-hero-title mt-4 max-w-3xl font-display text-2xl leading-[1.1] tracking-tight sm:text-3xl md:mt-5 md:text-5xl lg:text-6xl lg:leading-none">
              {project.title}
            </h1>
            <p class="project-hero-tagline mt-3 max-w-2xl text-sm leading-relaxed sm:text-base md:mt-4 md:text-lg">
              {project.tagline}
            </p>
            <p class="project-hero-role mt-4 hidden max-w-2xl items-center gap-2 rounded-full bg-white/10 px-3.5 py-1.5 text-xs backdrop-blur-sm md:inline-flex md:text-sm">
              <AppIcon name="briefcase" size={14} />
              {project.role}
            </p>
            {project.links.length > 0 ? (
              <div class="project-hero-links mt-6 flex flex-wrap gap-2 md:mt-8">
                {project.links.map((link) => (
                  <a
                    class="project-hero-link inline-flex min-w-0 items-center justify-center gap-1.5 rounded-full px-4 py-2.5 text-xs font-medium no-underline sm:text-sm"
                    href={link.href}
                    target={link.href.startsWith('/') ? undefined : '_blank'}
                    rel={link.href.startsWith('/') ? undefined : 'noreferrer'}
                    data-magnetic
                  >
                    {link.label}
                    <AppIcon name="arrow-up-right" size={14} class="shrink-0" />
                  </a>
                ))}
              </div>
            ) : project.slug === 'jornalpro-mobile' && !gallery ? (
              <p class="mt-6 text-sm text-mist md:mt-8">Aplicación Android (APK). Registro fotográfico pendiente.</p>
            ) : null}
          </div>
          <div class="hidden lg:flex lg:justify-end">
            <div class:list={['project-hero-logo relative flex h-52 w-52 items-center justify-center overflow-hidden rounded-[2rem] border border-white/10 p-8 backdrop-blur-md xl:h-56 xl:w-56', logoLightBg ? 'bg-white' : 'bg-white/8']}>
              {logo ? (
                <img src={logo} alt="" class="max-h-full max-w-full object-contain" />
              ) : (
                <AppIcon name={projectIcons[project.slug]} size={72} />
              )}
            </div>
          </div>
        </div>
      </div>
    </header>

    {gallery && (
      <CircularGallery
        shell="project"
        images={gallery.images}
        variant={gallery.variant}
        title={gallery.variant === 'phone' ? 'Aplicación móvil' : 'Capturas de pantalla'}
      />
    )}

    <div class="project-study mx-auto max-w-7xl px-4 py-8 md:px-8 md:py-12" data-reveal>
      <CaseStudyDeck project={project} />
    </div>

    <ProjectRelated projects={related} />
  </article>
  )}
</Layout>

{needsMermaid && (
<script>
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    securityLevel: 'loose',
    fontFamily: 'Poppins, sans-serif',
    themeVariables: {
      fontFamily: 'Poppins, sans-serif',
      fontSize: '14px',
      primaryColor: '#ebe6f4',
      primaryTextColor: '#0a0a0a',
      primaryBorderColor: '#7c3aed',
      lineColor: '#7c3aed',
      secondaryColor: '#f7f6fb',
      tertiaryColor: '#ede9fe',
      clusterBkg: 'transparent',
      clusterBorder: '#c9c2d8',
    },
    flowchart: {
      curve: 'basis',
      padding: 12,
      nodeSpacing: 28,
      rankSpacing: 40,
      htmlLabels: true,
    },
  });

  window.mermaid = mermaid;
  void mermaid.run();
</script>
)}
