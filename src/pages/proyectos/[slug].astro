---
import Layout from '../../layouts/Layout.astro';
import StackPills from '../../components/StackPills.astro';
import ModuleList from '../../components/ModuleList.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import LabCase from '../../components/LabCase.astro';
import {
  getProject,
  getRelatedProjects,
  projects,
} from '../../data/projects';
import { getLab, labs } from '../../data/labs';
import { projectIcons } from '../../data/icons';
import { getProjectCover, getProjectGallery, getProjectLogo } from '../../data/media';
import AppIcon from '../../components/AppIcon.astro';
import BackLink from '../../components/BackLink.astro';
import Carousel from '../../components/Carousel.astro';

export function getStaticPaths() {
  return [
    ...projects.map((project) => ({ params: { slug: project.slug } })),
    ...labs.map((lab) => ({ params: { slug: lab.slug } })),
  ];
}

const { slug } = Astro.params;
const project = getProject(slug!);
const lab = getLab(slug!);

if (!project && !lab) {
  throw new Error(`Proyecto no encontrado: ${slug}`);
}

const related = project ? getRelatedProjects(project.slug) : [];
const gallery = project ? getProjectGallery(project.slug) : undefined;
const logo = project ? getProjectLogo(project.slug) : undefined;
const cover = project ? getProjectCover(project.slug) : undefined;
const title = project?.title ?? lab!.title;
const description = project?.summary ?? lab!.tagline;
---

<Layout title={`${title} — Jesús Zavala`} description={description}>
  {lab && <LabCase lab={lab} />}
  {project && (
  <article>
    <header class="px-4 pt-3 md:px-8">
      <div class="mx-auto mb-3 max-w-6xl">
        <BackLink href="/#proyectos" />
      </div>
      <div class="tone-night relative mx-auto max-w-6xl overflow-hidden rounded-[1.5rem] px-5 py-8 md:rounded-[2rem] md:px-12 md:py-20" data-hero>
        {cover && (
          <img
            src={cover}
            alt=""
            class="pointer-events-none absolute inset-0 h-full w-full object-cover object-top opacity-25"
          />
        )}
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black via-black/80 to-black/55"></div>
        <div class="relative">
          <div class="mb-4 inline-flex h-12 w-12 items-center justify-center overflow-hidden rounded-2xl bg-paper/10 p-2 md:mb-6 md:h-16 md:w-16" data-hero-item>
            {logo ? (
              <img src={logo} alt="" class="h-full w-full object-contain" />
            ) : (
              <AppIcon name={projectIcons[project.slug]} size={36} />
            )}
          </div>
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent-soft md:text-sm" data-hero-item>
            {project.kicker} · {project.year}
          </p>
          <h1 class="mt-3 max-w-4xl font-display text-3xl tracking-tight md:text-6xl">
            {project.title}
          </h1>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-mist md:mt-5 md:text-xl" data-hero-item>{project.tagline}</p>
          <p class="mt-4 text-sm text-mist" data-hero-item>{project.role}</p>
          {project.links.length > 0 ? (
            <div class="mt-8 flex flex-wrap gap-3" data-hero-item>
              {project.links.map((link) => (
                <a
                  class="inline-flex items-center gap-2 rounded-full bg-paper px-4 py-2.5 text-sm font-medium text-ink no-underline hover:bg-accent-soft"
                  href={link.href}
                  target="_blank"
                  rel="noreferrer"
                  data-magnetic
                >
                  {link.label}
                  <AppIcon name="arrow-up-right" size={14} />
                </a>
              ))}
            </div>
          ) : project.slug === 'jornalpro-mobile' && !gallery ? (
            <p class="mt-8 text-sm text-mist">Aplicación Android (APK). Registro fotográfico pendiente.</p>
          ) : null}
        </div>
      </div>
    </header>

    {gallery && (
      <Carousel
        images={gallery.images}
        variant={gallery.variant}
        title={gallery.variant === 'phone' ? 'Aplicación móvil' : 'Capturas de pantalla'}
      />
    )}

    <section class="px-4 py-10 md:px-8 md:py-16">
      <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[1fr_1fr]">
        <div data-reveal>
          <p class="inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-accent">
            <AppIcon name="circle-alert" size={14} />
            Contexto
          </p>
          <p class="mt-3 text-sm leading-relaxed md:text-base">{project.problem}</p>
        </div>
        <div data-reveal>
          <p class="inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-accent">
            <AppIcon name="sparkles" size={14} />
            Descripción
          </p>
          <p class="mt-3 text-sm leading-relaxed md:text-base">{project.summary}</p>
        </div>
      </div>
    </section>

    <section class="px-5 pb-16 md:px-8">
      <div class="mx-auto max-w-6xl">
        <p class="inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-accent">
          <AppIcon name="cpu" size={14} />
          Stack
        </p>
        <div class="mt-5">
          <StackPills items={project.stack} />
        </div>
      </div>
    </section>

    <section class="px-5 pb-16 md:px-8">
      <div class="mx-auto max-w-6xl">
        <p class="inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-accent">
          <AppIcon name="share-2" size={14} />
          Arquitectura
        </p>
        <h2 class="mt-2 font-display text-2xl tracking-tight md:text-4xl">Arquitectura del sistema</h2>
        <div class="mt-8">
          <ArchDiagram chart={project.architecture} />
        </div>
      </div>
    </section>

    <section class="px-5 pb-16 md:px-8">
      <div class="mx-auto max-w-6xl">
        <p class="inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-accent">
          <AppIcon name="layers" size={14} />
          Módulos
        </p>
        <h2 class="mt-2 font-display text-2xl tracking-tight md:text-4xl">Módulos del sistema</h2>
        <div class="mt-8">
          <ModuleList modules={project.modules} />
        </div>
      </div>
    </section>

    <section class="px-5 pb-16 md:px-8">
      <div class="mx-auto max-w-6xl">
        <p class="inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-accent">
          <AppIcon name="workflow" size={14} />
          Funcionamiento
        </p>
        <ol class="mt-8 grid gap-4 md:grid-cols-2">
          {project.howItWorks.map((step, index) => (
            <li class="rounded-[1.6rem] bg-sand p-6" data-reveal>
              <span class="inline-flex items-center gap-2 text-sm font-medium text-accent">
                <AppIcon name="waypoints" size={14} />
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class="mt-2 leading-relaxed">{step}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="px-5 py-8 md:px-8 md:py-12">
      <div class="mx-auto max-w-6xl">
        <p class="inline-flex items-center gap-2 text-sm font-medium uppercase tracking-[0.18em] text-accent">
          <AppIcon name="badge-check" size={14} />
          Resultados
        </p>
        <ul class="mt-8 grid gap-4 md:grid-cols-2">
          {project.highlights.map((item) => (
            <li class="flex gap-3 rounded-[1.6rem] bg-accent-soft p-6 leading-relaxed" data-reveal>
              <span class="mt-0.5 text-accent"><AppIcon name="sparkles" size={18} /></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </section>

    {related.length > 0 && (
      <section class="px-5 pb-20 md:px-8">
        <div class="mx-auto max-w-6xl">
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-muted">Proyectos relacionados</p>
          <div class="mt-6 grid gap-4 md:grid-cols-3">
            {related.map((item) => (
              <ProjectCard project={item} />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
  )}
</Layout>

{project && (
<script is:inline type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
  mermaid.initialize({
    startOnLoad: true,
    theme: 'neutral',
    securityLevel: 'loose',
    fontFamily: 'Poppins, sans-serif',
  });
</script>
)}
