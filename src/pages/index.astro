---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Contact from '../components/Contact.astro';
import StackPills from '../components/StackPills.astro';
import { profile } from '../data/profile';
---

<Layout>
  <Hero />
  <About />
  <ProjectGrid />
  <section class="px-5 py-6 md:px-8 md:py-8">
    <div class="tone-ink mx-auto max-w-6xl rounded-3xl px-6 py-12 md:px-12 md:py-16">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent-soft">Stack</p>
      <h2 class="mt-3 max-w-xl text-3xl font-semibold tracking-tight md:text-4xl">
        Herramientas que uso cuando el producto tiene que vivir en producción.
      </h2>
      <div class="mt-8">
        <StackPills items={profile.stack} tone="dark" />
      </div>
    </div>
  </section>
  <Contact />
</Layout>
