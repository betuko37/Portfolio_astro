---
import Layout from '../layouts/Layout.astro';
---

<Layout title="No encontrado — Jesús Zavala" description="Esa página no existe.">
  <section class="px-5 py-24 md:px-8">
    <div class="mx-auto max-w-6xl">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">404</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-6xl">Esa ruta no existe.</h1>
      <a class="tone-ink mt-8 inline-block rounded-full px-6 py-3 text-sm font-medium no-underline" href="/">
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
