---
import Layout from '../layouts/Layout.astro';
import AppIcon from '../components/AppIcon.astro';
---

<Layout title="No encontrado — Jesús Zavala" description="Esa página no existe.">
  <section class="px-4 py-16 md:px-8 md:py-24">
    <div class="mx-auto max-w-6xl" data-hero>
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent" data-hero-item>404</p>
      <h1 class="mt-3 font-display text-4xl tracking-tight md:text-7xl" data-hero-item>
        Esa ruta <em class="italic text-accent">no existe</em>.
      </h1>
      <a
        class="tone-ink mt-8 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium no-underline"
        href="/"
        data-magnetic
        data-hero-item
      >
        <AppIcon name="home" size={16} />
        Volver al inicio
      </a>
    </div>
  </section>
</Layout>
